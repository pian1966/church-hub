rules_version = '2';

// Church & Trellis - who may read and write what (POPIA "security safeguards", s19).
// Paste this whole file into Firebase console > Firestore Database > Rules > Publish.
// Tested by tests/rules.test.mjs (runs automatically on GitHub after every change).
//
// How access works:
// - People sign in with Google or an email link. Their email address must be verified.
// - roles/{email} says what they may do: admin, pastor, rosters, kids or member, and which person record is theirs.
//   Only Administrators can change roles (and Pastors with the "access" tick, for the smaller roles). No roles document = no access at all.
// - People who share one email address (often a couple) share one sign-in: their roles document lists everyone's roles
//   (roles) and the other people it is for (also, at most 3). After signing in they choose who is using Church & Trellis;
//   the rules let the sign-in do what any of them may do (whoever reads that inbox can sign in as any of them anyway).
// - Medical notes (children) are for Children's ministry only. Pastoral notes are for Pastors only.
//   Administrators cannot read either; they can only delete them when someone asks to be deleted (POPIA s24).
// - Members see their own details, their own serving and leave, and the church directory
//   (only people who agreed to be in it).
// - Basic access comes in two kinds, decided by the person's category (automatically): Church Partners (and staff) get
//   Church Partner access; everyone else on Basic access is an attendee, who sees and does only what Settings > Attendees
//   allows (settings attendeeCan: names, directory, write, reply; ['names', 'write'] if the church hasn't chosen).
// - Members with no email: an Administrator gives a person a single-use sign-in code (invites/{code}, 14 days). The member's
//   phone signs in "anonymously" to read it, then chooses a 6-digit PIN: the account gets a made-up address that only Church & Trellis
//   uses (<number>-<v>@pin.church-hub.invalid, number = their cellphone number, or "c" and a 6-digit church number) with the PIN
//   as its password. In one write it records roles/{that address} (only ever Member access, for that person),
//   pinLogins/{number} (which address that number uses now) and marks the code used. From then on they sign in on any phone
//   with their number and PIN. With no roles document such an account can see nothing.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- who is asking ----------
    // A member signed in with their number and PIN (no email address of their own): see the top of this file. Their access
    // entry is roles/{that made-up address}, so everyone is looked up the same way, in as few steps as possible.
    function pinUser() { return request.auth != null && request.auth.token.get('email', '').matches('^c?[0-9]+-[0-9]+@pin[.]church-hub[.]invalid$'); }
    function signedIn() { return request.auth != null && (request.auth.token.email_verified == true || pinUser()); }
    function roleRef() { return /databases/$(database)/documents/roles/$(request.auth.token.email.lower()); }
    function hasRole() { return signedIn() && exists(roleRef()); }
    function access() { return get(roleRef()).data; }
    function myRoles() { return access().get('roles', [access().role]); }
    function isRole(list) { return hasRole() && myRoles().hasAny(list); }
    function admin() { return isRole(['admin']); }
    function staff() { return isRole(['admin', 'pastor', 'rosters', 'kids']); }
    function anyone() { return isRole(['admin', 'pastor', 'rosters', 'kids', 'member']); }
    function me() { return access().get('personId', ''); }
    // The other people who share this sign-in (a shared email address), and "is this one of us?"
    function also() { return access().get('also', []); }
    function myIds() { return [me()].concat(also()); }
    function isMe(pid) {
      return pid != '' && (pid == me() || (also().size() > 0 && pid == also()[0])
        || (also().size() > 1 && pid == also()[1]) || (also().size() > 2 && pid == also()[2]));
    }
    function meIn(list) {
      return (me() != '' && me() in list) || (also().size() > 0 && also()[0] in list)
        || (also().size() > 1 && also()[1] in list) || (also().size() > 2 && also()[2] in list);
    }
    function mine(personId) { return anyone() && isMe(personId); }
    // Church Partner access or an attendee (see the top of this file): an attendee has only Basic access and none of the
    // people on this sign-in is a Church Partner or on the staff (their category).
    function personRef(pid) { return /databases/$(database)/documents/people/$(pid); }
    function partnerPerson(pid) { return exists(personRef(pid)) && get(personRef(pid)).data.get('category', '') in ['Church Partner', 'Staff']; }
    // Only after anyone(). The access-list entry is read once (Firestore allows only so many steps per check).
    function attendee() {
      let d = access();
      let pid = d.get('personId', '');
      let a = d.get('also', []);
      return !d.get('roles', [d.role]).hasAny(['admin', 'pastor', 'rosters', 'kids'])
        && !(pid != '' && partnerPerson(pid))
        && !(a.size() > 0 && partnerPerson(a[0])) && !(a.size() > 1 && partnerPerson(a[1])) && !(a.size() > 2 && partnerPerson(a[2]));
    }
    function churchSettings() { return get(/databases/$(database)/documents/settings/church).data; }
    function attendeeCan(x) { return x in churchSettings().get('attendeeCan', ['names', 'write']); }
    function attendeeMay(x) { return anyone() && (!attendee() || attendeeCan(x)); }
    // The Senior Pastor (Rector), chosen in Settings > What Pastors can do
    function rector() { return isRole(['pastor']) && isMe(churchSettings().get('seniorPastorId', '')); }
    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    // What Pastors can do (Settings): an Administrator ticks abilities, which Church & Trellis copies onto each Pastor's
    // access-list entry as "can". The Senior Pastor (Rector), if one is chosen, gets their own ticks (seniorCan). may('leave') is true for Administrators, and for Pastors with that tick.
    // Abilities: settings, access, people, idnumbers, leave, rosters, privacy, import, words.
    // (These lists - the abilities, the roles and what attendees may do - are kept in js/access.js;
    // tests/access.test.js checks that this file still matches it.)
    function may(x) { return admin() || (isRole(['pastor']) && x in access().get('can', [])); }
    function rosterer() { return isRole(['admin', 'rosters']) || may('rosters'); }
    // The stand-in leave approver, between the dates on their access-list entry (Leave > Approvals > Stand-in approver)
    function standIn() { return anyone() && access().get('standInFrom', 0) <= request.time.toMillis() && request.time.toMillis() <= access().get('standInTo', 0); }
    // The roles a Pastor with "access" may give or take away (never Administrator or Pastor, never abilities)
    function smallRole(r) { return r in ['rosters', 'kids', 'member']; }
    function smallRoles(d) { return smallRole(d.role) && d.get('roles', [d.role]).hasOnly(['rosters', 'kids', 'member']); }
    // A roles document: its roles, and at most 3 other people sharing the sign-in
    function okRoles(d) {
      return d.get('roles', []).hasOnly(['admin', 'pastor', 'rosters', 'kids', 'member'])
        && d.get('also', []) is list && d.get('also', []).size() <= 3;
    }
    // The Elvanto robot (GitHub Actions) signs in with its own account. Its access-list entry names its account ID (uid),
    // so nobody else can use that email address. It can only read church settings and work on the Elvanto list.
    function robot() {
      return request.auth != null && request.auth.token.email != null && exists(roleRef())
        && access().role == 'robot' && access().get('uid', '') == request.auth.uid;
    }

    // ---------- access list (Administrators manage it from People > Edit details) ----------
    match /roles/{email} {
      allow read: if signedIn() && (email == request.auth.token.email.lower() || may('access'));
      allow create: if (admin() && request.resource.data.role in ['admin', 'pastor', 'rosters', 'kids', 'member', 'robot'] && okRoles(request.resource.data))
        || (may('access') && smallRoles(request.resource.data) && okRoles(request.resource.data) && request.resource.data.keys().hasOnly(['role', 'personId', 'name', 'roles', 'also', 'people']))
        || pinClaim(email);
      allow update: if (admin() && request.resource.data.role in ['admin', 'pastor', 'rosters', 'kids', 'member', 'robot'] && okRoles(request.resource.data))
        || (may('access') && smallRoles(resource.data) && smallRoles(request.resource.data) && okRoles(request.resource.data) && request.resource.data.keys().hasOnly(['role', 'personId', 'name', 'roles', 'also', 'people']))
        || (may('leave') && onlyChanges(['standInFrom', 'standInTo']) && request.resource.data.standInFrom is int && request.resource.data.standInTo is int);
      allow delete: if admin() || (may('access') && smallRoles(resource.data));
    }

    // ---------- sign-in codes and PINs (members with no email address) ----------
    // A PIN account's own access entry, roles/{its address}, made with a code: only ever Member access for the person on the
    // code, in the same write that spends the code and records pinLogins/{its number}. login = that number, pinV = the
    // version in its address, uid = its account id.
    function pinClaim(email) {
      let d = request.resource.data;
      let inv = get(/databases/$(database)/documents/invites/$(d.invite)).data;
      return pinUser() && email == request.auth.token.email
        && d.keys().hasOnly(['role', 'roles', 'personId', 'also', 'people', 'invite', 'name', 'linkedAt', 'login', 'pinV', 'uid'])
        && d.role == 'member' && d.roles == ['member'] && d.also == [] && d.people == {} && d.uid == request.auth.uid
        && d.invite is string && d.login is string && d.pinV is int
        && email == d.login + '-' + string(d.pinV) + '@pin.church-hub.invalid'
        && inv.personId == d.personId && inv.get('usedBy', '') == '' && request.time.toMillis() < inv.expires
        && getAfter(/databases/$(database)/documents/invites/$(d.invite)).data.usedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/pinLogins/$(d.login)).data.v == d.pinV;
    }
    // invites/{code}: { personId, name, role: 'member', expires: <ms>, by, createdAt, mobile?, dial?, usedBy?, usedAt? }. Knowing the
    // code is the key: anyone signed in (the phone signs in anonymously first) may fetch one by its code, never list them.
    // Only Administrators make or remove them.
    match /invites/{code} {
      allow get: if request.auth != null;
      allow list: if admin();
      allow create: if admin() && request.resource.data.role == 'member' && request.resource.data.get('usedBy', '') == ''
        && request.resource.data.expires is int && request.resource.data.personId is string && request.resource.data.personId != '';
      allow delete: if admin();
      // Marked used in the same write as the PIN account's access entry (so a code works once, before it expires)
      allow update: if pinUser()
        && resource.data.get('usedBy', '') == '' && request.time.toMillis() < resource.data.expires
        && onlyChanges(['usedBy', 'usedAt']) && request.resource.data.usedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/roles/$(request.auth.token.email)).data.invite == code;
    }
    // pinLogins/{login}: which version of the address a number (or "c" and a church number) signs in with now: { v, uid }.
    // The sign-in screen fetches it by the number typed, before anyone is signed in; nobody may list them.
    // pinLogins/dial = { dial }: the church's country calling code, for numbers typed as 082... (written by Administrators).
    match /pinLogins/{login} {
      allow get: if true;
      allow list: if false;
      allow delete: if admin();
      allow create, update: if (admin() && login == 'dial' && request.resource.data.keys().hasOnly(['dial']) && request.resource.data.dial is string)
        || (pinUser() && login != 'dial'
          && request.resource.data.keys().hasOnly(['v', 'uid']) && request.resource.data.uid == request.auth.uid && request.resource.data.v is int
          // only for this account's own address, in the write that makes its access entry
          && request.auth.token.email == login + '-' + string(request.resource.data.v) + '@pin.church-hub.invalid'
          && !exists(/databases/$(database)/documents/roles/$(request.auth.token.email))
          && getAfter(/databases/$(database)/documents/roles/$(request.auth.token.email)).data.login == login
          // a number already in use moves on only for the same person, or once that sign-in was switched off
          && (resource == null || (request.resource.data.v > resource.data.v
            && (!exists(/databases/$(database)/documents/roles/$(login + '-' + string(resource.data.v) + '@pin.church-hub.invalid'))
              || get(/databases/$(database)/documents/roles/$(login + '-' + string(resource.data.v) + '@pin.church-hub.invalid')).data.personId
                == getAfter(/databases/$(database)/documents/roles/$(request.auth.token.email)).data.personId))));
    }

    // ---------- church settings ----------
    match /settings/{doc} {
      // Older versions kept brochure wording here. Keep it private until an Administrator moves it to brochures/church.
      allow read: if admin()
        || (anyone() && !resource.data.keys().hasAny(['brochures']))
        || (robot() && !resource.data.keys().hasAny(['brochures']));
      allow create: if admin() && !request.resource.data.keys().hasAny(['brochures']);
      allow delete: if admin();
      // A Pastor with "settings" may change everything except what Pastors can do, what the Senior Pastor can do,
      // and who the Senior Pastor is (only an Administrator sets those)
      // The Senior Pastor may choose the librarians and record the review date, and what attendees may do, and change nothing else here
      allow update: if (admin() && !request.resource.data.keys().hasAny(['brochures'])) || (may('settings')
        && request.resource.data.get('pastorCan', []) == resource.data.get('pastorCan', [])
        && request.resource.data.get('seniorCan', []) == resource.data.get('seniorCan', [])
        && request.resource.data.get('seniorPastorId', '') == resource.data.get('seniorPastorId', '')
        && request.resource.data.get('brochures', null) == resource.data.get('brochures', null))
        || (isRole(['pastor']) && isMe(resource.data.get('seniorPastorId', ''))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['librarianIds', 'librarianReviewedAt'])
          && request.resource.data.get('librarianIds', []) is list
          && request.resource.data.get('librarianReviewedAt', '') is string
          && request.resource.data.get('librarianReviewedAt', '').size() >= 20
          && request.resource.data.get('librarianReviewedAt', '').size() <= 40)
        || (isRole(['pastor']) && isMe(resource.data.get('seniorPastorId', ''))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendeeCan'])
          && request.resource.data.attendeeCan is list && request.resource.data.attendeeCan.hasOnly(['names', 'directory', 'write', 'reply']));
    }
    // Brochure wording is editable only by Administrators; the Rector may also read it, to print the brochures.
    match /brochures/{id} {
      allow read: if (admin() || rector()) && id == 'church';
      allow write: if admin() && id == 'church';
    }

    // ---------- people ----------
    // Name, family and contact details. Members may correct their own name and contact details.
    match /people/{id} {
      allow read: if staff() || mine(id);
      allow create: if isRole(['admin', 'pastor']);
      allow update: if isRole(['admin', 'pastor'])
        || (mine(id) && onlyChanges(['firstName', 'lastName', 'preferredName', 'email', 'mobile', 'photo', 'updatedAt']))
        || (isRole(['kids']) && resource.data.familyRole == 'child' && onlyChanges(['photo', 'updatedAt']));
      allow delete: if may('people');
    }
    // Birthday, key dates, staff details. Children's ministry sees children's details only.
    match /details/{id} {
      allow read: if isRole(['admin', 'pastor']) || mine(id)
        || (isRole(['kids']) && resource.data.familyRole == 'child');
      allow write: if isRole(['admin', 'pastor']);
    }
    // Children's medical notes and allergies (special personal information): Children's ministry only.
    match /medical/{id} {
      allow read, create, update: if isRole(['kids']);
      allow delete: if isRole(['kids']) || may('people');
    }
    // Pastoral notes, one document per person: Pastors only.
    match /notes/{personId} {
      allow read, create, update: if isRole(['pastor']);
      allow delete: if isRole(['pastor']) || may('people');
    }
    // Adults responsible for a child (parents, guardians, carers, trusted collectors): who may consent, gets messages, may collect.
    // Administrators, Pastors and Children's ministry manage them; an adult may see the links that name them.
    match /guardians/{id} {
      allow read: if isRole(['admin', 'pastor', 'kids']) || mine(resource.data.adultId);
      allow write: if isRole(['admin', 'pastor', 'kids']);
    }
    // Not allowed to collect a child (e.g. a court order): restricted, views are logged by the app.
    match /noCollect/{id} {
      allow read, write: if isRole(['admin', 'pastor', 'kids']);
    }
    // Contact details, for adults who agreed to share them. directory: everyone signed in can read it - their name and photo,
    // plus only what Settings lets Church Partners see (mobile, email, address, spouse). contacts: staff and leaders only -
    // home address and spouse, when Settings lets Roster coordinators or Children's ministry see them.
    // Attendees see it only when Settings > Attendees lets them (directory); otherwise at most names (below).
    match /directory/{id} {
      allow read: if staff() || attendeeMay('directory');
      allow create, update: if (isRole(['admin', 'pastor']) || mine(id))
        && request.resource.data.keys().hasOnly(['firstName', 'lastName', 'preferredName', 'mobile', 'email', 'shareAddress', 'shareSpouse', 'photo', 'care']);
      allow delete: if isRole(['admin', 'pastor']) || mine(id);
    }
    // names: the names of Church Partners in the directory - all an attendee sees of other people (when Settings allows).
    match /names/{id} {
      allow read: if staff() || attendeeMay('names') || attendeeMay('directory');
      allow create, update: if (isRole(['admin', 'pastor']) || mine(id))
        && request.resource.data.keys().hasOnly(['firstName', 'lastName', 'preferredName']);
      allow delete: if isRole(['admin', 'pastor']) || mine(id);
    }
    // pickNames: the name of every adult in the church (first, last and preferred name - nothing else), so a Midweek Group's
    // leaders can add anyone to their group, attendees too. Read by Administrators, Pastors and anyone who leads a Midweek
    // Group; lifeLeaders/all lists who that is. Administrators and Pastors keep both in step with People and the groups.
    function leadsLife() { return anyone() && meIn(get(/databases/$(database)/documents/lifeLeaders/all).data.get('ids', [])); }
    match /pickNames/{id} {
      allow read: if isRole(['admin', 'pastor']) || leadsLife();
      allow create, update: if isRole(['admin', 'pastor'])
        && request.resource.data.keys().hasOnly(['firstName', 'lastName', 'preferredName']);
      allow delete: if isRole(['admin', 'pastor']);
    }
    match /lifeLeaders/{doc} {
      allow read, delete: if isRole(['admin', 'pastor']);
      allow create, update: if isRole(['admin', 'pastor']) && doc == 'all'
        && request.resource.data.keys().hasOnly(['ids']) && request.resource.data.ids is list;
    }
    match /contacts/{id} {
      allow read: if staff();
      allow create, update: if (isRole(['admin', 'pastor']) || mine(id))
        && request.resource.data.keys().hasOnly(['shareAddress', 'shareSpouse']);
      allow delete: if isRole(['admin', 'pastor']) || mine(id);
    }
    // Photos, one small picture per person. Adults: staff, the person, and members when the adult is in the directory.
    // Children: Administrators, Pastors and Children's ministry only. Administrators and Pastors add photos; Children's
    // ministry for children; anyone for themselves (adults).
    function isChild(id) { return get(/databases/$(database)/documents/people/$(id)).data.get('familyRole', '') == 'child'; }
    match /photos/{id} {
      allow read: if isChild(id) ? isRole(['admin', 'pastor', 'kids'])
        : (staff() || mine(id) || (attendeeMay('directory') && exists(/databases/$(database)/documents/directory/$(id))));
      allow create, update: if request.resource.data.keys().hasOnly(['data', 'updatedAt'])
        && request.resource.data.data is string && request.resource.data.data.size() < 200000
        && (isRole(['admin', 'pastor']) || (isChild(id) ? isRole(['kids']) : mine(id)));
      allow delete: if isRole(['admin', 'pastor']) || (isChild(id) ? isRole(['kids']) : mine(id));
    }
    // Church office notes (e.g. brought across from Elvanto): Administrators and Pastors. Pastoral notes stay Pastors only.
    match /officeNotes/{personId} {
      allow read, write: if isRole(['admin', 'pastor']);
    }
    // ID numbers: Administrators only (and the person may see their own). Kept apart; every view is logged by the app.
    match /idNumbers/{personId} {
      allow read: if may('idnumbers') || mine(personId);
      allow create, update: if may('idnumbers') && request.resource.data.keys().hasOnly(['value', 'updatedAt'])
        && request.resource.data.value is string && request.resource.data.value.size() <= 20;
      // Someone applying to become a Church Partner may give their own ID number once (never change one already kept)
      allow create: if mine(personId) && request.resource.data.keys().hasOnly(['value', 'updatedAt'])
        && request.resource.data.value is string && request.resource.data.value.size() <= 20;
      allow delete: if may('idnumbers') || may('people');
    }
    match /families/{id} {
      allow read: if staff();
      allow write: if isRole(['admin', 'pastor']);
    }
    // Consent register. Members record their own choices; Children's ministry sees medical and photo consent.
    match /consents/{id} {
      allow read: if isRole(['admin', 'pastor']) || mine(resource.data.personId)
        || (isRole(['kids']) && resource.data.purpose.matches('Children.s medical notes|Photos'));
      allow create: if isRole(['admin', 'pastor'])
        || (mine(request.resource.data.personId) && request.resource.data.method == 'Changed in the app');
      allow update: if isRole(['admin', 'pastor'])
        || (mine(resource.data.personId) && onlyChanges(['withdrawnAt', 'updatedAt']));
      allow delete: if may('people');
    }

    // ---------- rosters ----------
    match /teams/{id} { allow read: if anyone(); allow write: if rosterer(); }
    match /positions/{id} { allow read: if anyone(); allow write: if rosterer(); }
    match /services/{id} { allow read: if anyone(); allow write: if rosterer(); }
    match /skills/{id} {
      allow read: if staff() || mine(resource.data.personId);
      allow write: if rosterer();
    }
    // Members can accept or decline their own turns, nothing else.
    match /assignments/{id} {
      allow read: if staff() || mine(resource.data.personId);
      allow create, delete: if rosterer();
      allow update: if rosterer()
        || (mine(resource.data.personId) && onlyChanges(['status', 'updatedAt'])
            && request.resource.data.status in ['accepted', 'declined']);
    }
    // Serve together / keep apart. Members may set up groups they are part of.
    match /groups/{id} {
      allow read: if staff() || (anyone() && meIn(resource.data.memberIds));
      allow create: if rosterer() || (anyone() && meIn(request.resource.data.memberIds));
      allow update: if rosterer()
        || (anyone() && meIn(resource.data.memberIds) && meIn(request.resource.data.memberIds));
      allow delete: if rosterer() || (anyone() && meIn(resource.data.memberIds));
    }
    // Administrator-managed groups contain membership IDs only, never contact details.
    match /customGroups/{id} {
      allow read: if admin() || (anyone() && (resource.data.visibility == 'church' || meIn(resource.data.memberIds)));
      allow create, update: if admin() && request.resource.data.keys().hasOnly(['name', 'description', 'memberIds', 'visibility', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.description is string && request.resource.data.description.size() <= 500
        && request.resource.data.memberIds is list && request.resource.data.memberIds.size() <= 5000
        && request.resource.data.visibility in ['church', 'members']
        && (!request.resource.data.keys().hasAny(['createdAt']) || request.resource.data.createdAt is string)
        && (!request.resource.data.keys().hasAny(['updatedAt']) || request.resource.data.updatedAt is string);
      allow delete: if admin();
    }
    // Care groups. Administrators and Pastors set them up; a group's carers (leaderIds) may add and remove its members.
    // Members read their own group, and each member's card in it (share/{person}): their name, and the rest only
    // if they agreed (consent "Care group"). Each person keeps their own card up to date.
    function careRef(gid) { return /databases/$(database)/documents/careGroups/$(gid); }
    function inCare(gid) { return anyone() && meIn(get(careRef(gid)).data.get('memberIds', [])); }
    function leadsCare(gid) { return anyone() && meIn(get(careRef(gid)).data.get('leaderIds', [])); }
    // Settings -> Who can see what: Roster coordinators and Children's ministry may see every group and who is in it
    // (settings seeCare), but not the members' cards
    function seeCare() { return get(/databases/$(database)/documents/settings/church).data.get('seeCare', []); }
    // Settings -> Who can see what: may members see everyone in their own group (seeCareOwn, on unless switched off)?
    // When off they see their carers' cards and their own; the carers still see everyone in their group.
    function careOwn() { return get(/databases/$(database)/documents/settings/church).data.get('seeCareOwn', true) != false; }
    function careCarer(gid, pid) { return pid in get(careRef(gid)).data.get('leaderIds', []); }
    function seesCare() { return (isRole(['rosters']) && 'rosters' in seeCare()) || (isRole(['kids']) && 'kids' in seeCare()); }
    match /careGroups/{gid} {
      allow read: if isRole(['admin', 'pastor']) || seesCare() || (anyone() && meIn(resource.data.get('memberIds', [])));
      allow create, delete: if isRole(['admin', 'pastor']);
      allow update: if isRole(['admin', 'pastor'])
        || (anyone() && meIn(resource.data.get('leaderIds', [])) && onlyChanges(['memberIds', 'names', 'updatedAt'])
            && meIn(request.resource.data.memberIds) && request.resource.data.memberIds.hasAll(resource.data.get('leaderIds', [])))
        // a life group's leaders (type life: Bible studies, midweek groups) may also name their group and say when and where it meets
        || (anyone() && resource.data.get('type', '') == 'life' && meIn(resource.data.get('leaderIds', [])) && onlyChanges(['name', 'memberIds', 'names', 'when', 'venue', 'roles', 'updatedAt'])
            && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
            && meIn(request.resource.data.memberIds) && request.resource.data.memberIds.hasAll(resource.data.get('leaderIds', [])));
      match /share/{pid} {
        allow read: if isRole(['admin', 'pastor']) || (inCare(gid) && (careOwn() || mine(pid) || leadsCare(gid) || careCarer(gid, pid)));
        allow create, update: if (isRole(['admin', 'pastor']) || (mine(pid) && inCare(gid)))
          && request.resource.data.keys().hasOnly(['firstName', 'lastName', 'preferredName', 'ok', 'mobile', 'email', 'address', 'birthday', 'photo', 'leader', 'updatedAt', 'createdAt'])
          && (request.resource.data.get('photo', '') is string) && request.resource.data.get('photo', '').size() < 40000;
        allow delete: if isRole(['admin', 'pastor']) || mine(pid) || leadsCare(gid);
      }
    }
    // Messages inside the app (js/messages.js). A message lists the people it went to (to), worked out when it was sent.
    // Administrators and Pastors send to anyone (a group, or people they tick: kind people); a care group's carers (or a life group's leaders: kind life) to
    // their group, a message group's leaders to theirs and anyone on a leadership group (kind leaders) to that group - all of
    // it, or only some of its people (to is checked).
    // Read by the people it went to, its sender, Administrators and Pastors. Recipients can add themselves to
    // deliveredBy and readBy; Administrators and Pastors can add their own status to Office messages.
    // The sender, Administrators and Pastors may delete it.
    function msgGroupRef(gid) { return /databases/$(database)/documents/msgGroups/$(gid); }
    function manager() { return isRole(['admin', 'pastor']); }
    function mayTrackMessage(m) { return meIn(m.get('to', [])) || (m.kind == 'office' && manager() && !isMe(m.fromId)); }
    // A direct message (kind direct) goes to one person: a reply goes back to the sender of a message that came to you
    // (replyTo); a new one to a minister (a Pastor) or to a leader of a Midweek Group you are in (groupId). Attendees
    // write only with Settings' "write" and reply only with "reply" (or to a minister, when they may write).
    function careOf(gid) { return get(careRef(gid)).data; }
    function minister(pid) { return exists(personRef(pid)) && get(personRef(pid)).data.get('appRole', '') == 'pastor'; }
    function msgRef(id) { return /databases/$(database)/documents/messages/$(id); }
    // The message being answered came to this sign-in, from the person the reply goes to
    function repliesTo(rt, to0) { return exists(msgRef(rt)) && get(msgRef(rt)).data.get('fromId', '') == to0 && meIn(get(msgRef(rt)).data.get('to', [])); }
    // A leader of a Midweek Group (life group) this sign-in is in
    function lifeLeader(gid, pid) {
      let g = careOf(gid);
      return g.get('type', '') == 'life' && pid in g.get('leaderIds', []) && meIn(g.get('memberIds', []));
    }
    // What attendees may do is read once per check (Firestore allows only so many steps)
    function directOk(m, to0) {
      let att = attendee();
      let on = att ? churchSettings().get('attendeeCan', ['names', 'write']) : ['write', 'reply'];
      let rt = m.get('replyTo', '');
      let gid = m.get('groupId', '');
      return !isMe(to0) && (rt != ''
        ? repliesTo(rt, to0) && ('reply' in on || ('write' in on && minister(to0)))
        : 'write' in on && (gid == '' ? minister(to0) : lifeLeader(gid, to0)));
    }
    function mayDirect(m) { return m.kind == 'direct' && m.to.size() == 1 && directOk(m, m.to[0]); }
    // A private message to the person who pinned a notice or listed something (Community board, Marketplace: about, aboutId):
    // from anyone who sees it while it is live ("I can help", "I'm interested"), or from a keeper about their decision.
    function itemRef(p, id) { return /databases/$(database)/documents/$(p)/$(id); }
    function aboutItem(m) {
      return m.kind == 'direct' && m.to.size() == 1 && m.get('replyTo', '') == '' && m.get('about', '') in ['board', 'market']
        && m.get('aboutId', '') is string && m.get('aboutId', '').size() > 0 && !isMe(m.to[0])
        && aboutPoster(m.about, get(itemRef(m.about, m.aboutId)).data, m.to[0]);
    }
    function aboutPoster(p, x, to0) { return x.personId == to0 && ((x.status == 'live' && communityPerson()) || keepsPart(p)); }
    // Roster messages (kind roster): a roster coordinator or Administrator tells volunteers they are on the roster or
    // reminds them to reply (ask, remind); a volunteer who can't make it tells the roster team (declined) - the
    // Administrators, Roster coordinators and chosen people listed in settings.rosterTeam.
    function mayRosterNote(m) {
      return m.get('turns', []) is list && m.get('turns', []).size() > 0 && m.get('turns', []).size() <= 100
        && ((m.get('roster', '') in ['ask', 'remind', 'off'] && rosterer())
          || (m.get('roster', '') == 'declined' && m.to.hasOnly(churchSettings().get('rosterTeam', []))));
    }
    function mayWriteTo(m) {
      return !m.keys().hasAny(['roster', 'turns']) && ((m.kind == 'office' && m.to.size() == 0 && (attendeeMay('write') || (anyone() && m.get('about', '') == 'partnerApp')))
        || manager()
        || mayDirect(m)
        || ((m.kind == 'care' || m.kind == 'life') && meIn(get(careRef(m.groupId)).data.get('leaderIds', [])) && m.to.hasOnly(get(careRef(m.groupId)).data.get('memberIds', [])))
        || (m.kind == 'group' && meIn(get(msgGroupRef(m.groupId)).data.get('leaderIds', [])) && m.to.hasOnly(get(msgGroupRef(m.groupId)).data.get('memberIds', []).concat(get(msgGroupRef(m.groupId)).data.get('leaderIds', []))))
        || (m.kind == 'leaders' && meIn(get(/databases/$(database)/documents/leaderBodies/$(m.groupId)).data.get('memberIds', [])) && m.to.hasOnly(get(/databases/$(database)/documents/leaderBodies/$(m.groupId)).data.get('memberIds', []))));
    }
    // Roster messages are checked on their own (fewer steps: Firestore allows only so many per request)
    // A message about a notice or listing is checked on its own as well (aboutItem): fewer steps.
    // This week's links for a Midweek Group (about study): from its leaders or co-leaders (or Administrators and Pastors), to its members
    function studyNote(m) {
      let g = careOf(m.groupId);
      return m.kind == 'life' && m.get('aboutId', '') is string && m.get('aboutId', '').size() > 0
        && (manager() || postsLife(g)) && m.to.hasOnly(g.get('memberIds', []));
    }
    // Events (js/events.js): a reminder (about remind) goes from a person to their own inbox, about an event they can see;
    // a message to everyone coming (about event) is from the event's organisers
    function eventNote(m) {
      return m.kind == 'event' && m.get('aboutId', '') is string && m.get('aboutId', '').size() > 0
        && ((m.about == 'remind' && m.to.size() == 1 && isMe(m.to[0]) && exists(eventRef(m.aboutId)))
          || (m.about == 'event' && organises()));
    }
    function maySendTo(m) {
      return m.kind == 'roster' ? mayRosterNote(m)
        : (m.kind == 'event' ? eventNote(m)
        : (m.get('about', '') in ['board', 'market'] ? aboutItem(m) : (m.get('about', '') == 'study' ? studyNote(m) : mayWriteTo(m))));
    }
    match /messages/{id} {
      allow read: if manager() || (anyone() && (meIn(resource.data.get('to', [])) || isMe(resource.data.get('fromId', ''))));
      allow create: if anyone() && isMe(request.resource.data.fromId)
        && request.resource.data.keys().hasOnly(['kind', 'groupId', 'audience', 'some', 'replyTo', 'roster', 'turns', 'about', 'aboutId', 'showFrom', 'title', 'body', 'fromId', 'fromName', 'to', 'deliveredBy', 'readBy', 'createdAt', 'updatedAt'])
        && (request.resource.data.get('about', '') == '' || (request.resource.data.about == 'partnerApp' && request.resource.data.kind == 'office')
          || (request.resource.data.about in ['board', 'market'] && request.resource.data.kind == 'direct')
          || (request.resource.data.about == 'study' && request.resource.data.kind == 'life')
          || (request.resource.data.about in ['remind', 'event'] && request.resource.data.kind == 'event'))
        && request.resource.data.get('showFrom', 0) is int
        && request.resource.data.kind in ['office', 'care', 'life', 'group', 'leaders', 'staff', 'partners', 'people', 'direct', 'roster', 'event']
        && request.resource.data.get('replyTo', '') is string && request.resource.data.get('replyTo', '').size() <= 100
        && request.resource.data.get('some', false) is bool
        && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 4000
        && request.resource.data.get('title', '') is string && request.resource.data.get('title', '').size() <= 120
        && request.resource.data.to is list
        && ((request.resource.data.kind == 'office' && request.resource.data.to.size() == 0)
          || (request.resource.data.kind != 'office' && request.resource.data.to.size() > 0 && request.resource.data.to.size() <= 3000))
        && request.resource.data.get('deliveredBy', []) is list && request.resource.data.get('deliveredBy', []).hasOnly(myIds())
        && request.resource.data.readBy is list && request.resource.data.readBy.hasOnly(myIds())
        && maySendTo(request.resource.data);
      allow update: if anyone() && mayTrackMessage(resource.data) && onlyChanges(['readBy', 'deliveredBy'])
        && request.resource.data.get('deliveredBy', []) is list
        && request.resource.data.get('deliveredBy', []).hasAll(resource.data.get('deliveredBy', []))
        && request.resource.data.get('deliveredBy', []).removeAll(resource.data.get('deliveredBy', [])).hasOnly(myIds())
        && request.resource.data.get('readBy', []) is list
        && request.resource.data.readBy.hasAll(resource.data.get('readBy', []))
        && request.resource.data.readBy.removeAll(resource.data.get('readBy', [])).hasOnly(myIds());
      allow delete: if manager() || (anyone() && isMe(resource.data.get('fromId', '')));
    }
    // Midweek Groups online (js/studies.js): this week's meeting and notes links. Posted by the group's leaders and co-leaders
    // (and Administrators and Pastors); read by the group's members when it was posted (to) - or by anyone signed in when the
    // group opened it to the whole church (open). Only web links (http or https).
    function postsLife(g) {
      return anyone() && g.get('type', '') == 'life'
        && (meIn(g.get('leaderIds', [])) || (meIn(g.get('memberIds', [])) && g.get('roles', {}).get(me(), '') == 'coleader'));
    }
    function okLink(u) { return u is string && u.size() <= 500 && (u == '' || u.matches('https?://[^ ]+')); }
    function okStudy(d) {
      return d.keys().hasOnly(['groupId', 'groupName', 'date', 'time', 'meet', 'notes', 'topic', 'open', 'showFrom', 'to', 'fromId', 'fromName', 'createdAt', 'updatedAt'])
        && d.groupId is string && d.date is string && d.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') && d.time is string && d.time.matches('[0-2][0-9]:[0-5][0-9]')
        && okLink(d.get('meet', '')) && okLink(d.get('notes', '')) && d.get('meet', '') + d.get('notes', '') != ''
        && d.get('topic', '') is string && d.get('topic', '').size() <= 120 && d.get('groupName', '') is string && d.get('groupName', '').size() <= 80
        && d.get('open', false) is bool && d.get('showFrom', 0) is int && d.to is list && d.to.size() <= 3000
        && d.get('fromName', '') is string && d.get('fromName', '').size() <= 100 && d.get('fromId', '') is string;
    }
    function mayPostStudy(d) { let g = careOf(d.groupId); return (manager() || postsLife(g)) && d.to.hasOnly(g.get('memberIds', [])); }
    match /studies/{id} {
      allow read: if manager() || (anyone() && (resource.data.get('open', false) == true || meIn(resource.data.get('to', []))));
      allow create: if anyone() && okStudy(request.resource.data) && isMe(request.resource.data.fromId) && mayPostStudy(request.resource.data);
      allow update: if anyone() && okStudy(request.resource.data) && request.resource.data.groupId == resource.data.groupId && mayPostStudy(request.resource.data);
      allow delete: if manager() || postsLife(careOf(resource.data.groupId));
    }
    // Message groups (e.g. Worship team leaders): Administrators and Pastors set them up; members see the groups they are in.
    match /msgGroups/{gid} {
      allow read: if manager() || (anyone() && meIn(resource.data.get('memberIds', [])));
      allow write: if manager();
    }
    // Offers to serve: a person asks to join a position, change how often, or stop; the roster coordinator answers.
    match /serveOffers/{id} {
      allow read: if rosterer() || mine(resource.data.personId);
      allow create: if rosterer()
        || (mine(request.resource.data.personId) && request.resource.data.status == 'waiting'
            && request.resource.data.kind in ['join', 'change', 'stop']
            && request.resource.data.keys().hasOnly(['personId', 'positionId', 'kind', 'frequency', 'times', 'note', 'status', 'createdAt', 'updatedAt']));
      allow update: if rosterer();
      allow delete: if rosterer() || mine(resource.data.personId);
    }
    // Family details people ask the church office to change (marital status, wedding anniversary, spouse, children).
    // Nothing changes until an Administrator checks the request and makes the changes.
    match /detailChanges/{id} {
      allow read: if may('people') || mine(resource.data.personId);
      allow create: if may('people')
        || (mine(request.resource.data.personId) && request.resource.data.status == 'waiting'
            && request.resource.data.keys().hasOnly(['personId', 'maritalStatus', 'anniversary', 'spouse', 'children', 'note', 'status', 'createdAt', 'updatedAt']));
      allow update: if may('people');
      allow delete: if may('people') || mine(resource.data.personId);
    }
    // Applications to become a Church Partner, sent from the person's own page. Administrators and Pastors read and answer
    // them (how someone came to faith is religious information: special personal information, kept for the church's members).
    match /partnerApps/{id} {
      allow read: if isRole(['admin', 'pastor']) || mine(resource.data.personId);
      allow create: if isRole(['admin', 'pastor'])
        || (mine(request.resource.data.personId) && request.resource.data.status == 'waiting'
            && request.resource.data.keys().hasOnly(['personId', 'spouse', 'anniversary', 'children', 'since', 'faith', 'story', 'otherChurch', 'otherWhich',
              'classOk', 'study', 'questions', 'serve', 'declaration', 'loyalty', 'birthDate', 'directory', 'status', 'createdAt', 'updatedAt']));
      allow update: if isRole(['admin', 'pastor']);
      allow delete: if isRole(['admin', 'pastor']) || mine(resource.data.personId);
    }
    // Away dates people enter themselves.
    match /blockouts/{id} {
      allow read: if staff() || mine(resource.data.personId);
      allow create, update: if rosterer() || mine(request.resource.data.personId);
      allow delete: if rosterer() || mine(resource.data.personId);
    }
    // Approved leave as plain dates (no leave type or reason), so rosters can skip people who are away.
    match /away/{id} {
      allow read: if anyone();
      allow create, update: if may('leave')
        || ((mine(request.resource.data.personId) || standIn()) && request.resource.data.keys().hasOnly(['personId', 'from', 'to']));
      allow delete: if may('leave') || mine(resource.data.personId);
    }

    // ---------- leave (same rules as Leave Manager) ----------
    match /leave/{doc} {
      allow read: if anyone();
      allow write: if may('leave');
    }
    // Staff see and request their own leave; only Administrators approve.
    match /leaveRequests/{id} {
      allow read: if may('leave') || standIn() || mine(resource.data.staffId);
      allow create: if may('leave') || (mine(request.resource.data.staffId) && (
        request.resource.data.status == 'Pending'
        || (request.resource.data.status == 'Approved'
            && request.resource.data.type in get(/databases/$(database)/documents/leave/config).data.autoApprove)));
      allow update: if may('leave')
        || (mine(resource.data.staffId) && request.resource.data.status == 'Cancelled'
            && onlyChanges(['status', 'cancelledBy']))
        || (standIn() && !isMe(resource.data.staffId) && resource.data.status == 'Pending'
            && request.resource.data.status in ['Approved', 'Declined'] && onlyChanges(['status', 'decidedBy', 'decidedOn']));
      allow delete: if may('leave');
    }
    match /leaveAdjustments/{id} {
      allow read: if may('leave') || mine(resource.data.staffId);
      allow write: if may('leave');
    }

    // ---------- Elvanto: approved leave as Unavailable Volunteers (names and dates only) ----------
    // Administrators manage the list; staff add entries for their own leave (e.g. cancelling approved leave);
    // the robot reads it and reports what it did.
    match /elvantoSync/{id} {
      allow read: if may('import') || robot() || mine(resource.data.personId);
      allow create: if may('import')
        || ((mine(request.resource.data.personId) || standIn()) && request.resource.data.status == 'Waiting'
            && request.resource.data.keys().hasOnly(['personId', 'name', 'start', 'end', 'want', 'have', 'haveNote', 'status', 'note', 'createdAt', 'updatedAt']));
      allow update: if may('import')
        || ((mine(resource.data.personId) || standIn()) && request.resource.data.personId == resource.data.personId && request.resource.data.status == 'Waiting'
            && onlyChanges(['name', 'start', 'end', 'want', 'status', 'note', 'updatedAt']))
        || (robot() && onlyChanges(['status', 'note', 'have', 'haveNote', 'doneAt']));
      allow delete: if may('import');
    }
    // What the robot found in Elvanto (nightly, when switched on): names and dates of Unavailable Volunteers, for an
    // Administrator to check and apply in Church & Trellis (Import). The robot writes it; only Administrators read or delete it.
    match /elvantoFound/{id} {
      allow read, delete: if may('import');
      allow create, update: if robot() && request.resource.data.keys().hasOnly(['readAt', 'entries', 'rows', 'unread', 'pages', 'applied']);
    }
    match /robotStatus/{id} {
      allow read: if may('import');
      allow write: if robot();
    }

    // ---------- translations ----------
    // Anyone signed in may suggest better wording in a language. The people who check a language (the languages on their
    // access-list entry, set by an Administrator) and Administrators decide; approved wording goes into words/{language},
    // which everyone signed in reads. A suggestion keeps who sent it, so the checker can thank or ask them.
    function checks(lang) { return anyone() && lang in access().get('langs', []); }
    match /words/{lang} {
      allow read: if anyone();
      allow create, update: if (may('words') || checks(lang)) && request.resource.data.keys().hasOnly(['words', 'updatedAt', 'createdAt', 'by'])
        && request.resource.data.words is map;
      allow delete: if may('words') || checks(lang);
    }
    match /wordIdeas/{id} {
      allow read: if may('words') || mine(resource.data.personId) || checks(resource.data.lang);
      allow create: if mine(request.resource.data.personId) && request.resource.data.status == 'waiting'
        && request.resource.data.keys().hasOnly(['lang', 'en', 'text', 'note', 'personId', 'name', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.lang is string && request.resource.data.en is string
        && request.resource.data.text is string && request.resource.data.text.size() <= 3000
        && request.resource.data.get('note', '') is string && request.resource.data.get('note', '').size() <= 500;
      allow update: if (may('words') || checks(resource.data.lang))
        && onlyChanges(['status', 'reply', 'reviewedBy', 'reviewedAt', 'updatedAt'])
        && request.resource.data.status in ['used', 'declined'];
      allow delete: if may('words') || checks(resource.data.lang) || mine(resource.data.personId);
    }

    // ---------- leadership groups (js/leaders.js): the Council, elders, ministry leaders ----------
    // Names, roles, titles and portfolios only. Administrators and Pastors set them up. An open group is seen by everyone
    // signed in; any other only by its own members.
    function bodyRef(id) { return /databases/$(database)/documents/leaderBodies/$(id); }
    function inBody(id) { return anyone() && meIn(get(bodyRef(id)).data.get('memberIds', [])); }
    match /leaderBodies/{id} {
      allow read: if manager() || (anyone() && (resource.data.get('open', false) == true || meIn(resource.data.get('memberIds', []))));
      allow create, update: if manager() && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.open is bool && request.resource.data.memberIds is list;
      allow delete: if manager();
    }

    // ---------- the Archive (js/archive.js): minutes, plans, staff contracts, appraisals ----------
    // Archive access is limited to Administrators and Council members. The record's own access rule remains an
    // additional limit for Council members; Administrators see and manage every record. Files follow the same rule.
    function seniorId() { return get(/databases/$(database)/documents/settings/church).data.get('seniorPastorId', ''); }
    function keeper() { return admin() || (isRole(['pastor']) && isMe(seniorId())); }
    function archivePreviewMember(id) {
      return id != '' && exists(/databases/$(database)/documents/archivePreviewMembers/$(id));
    }
    function councilMember() {
      return anyone() && (archivePreviewMember(me())
        || (also().size() > 0 && archivePreviewMember(also()[0]))
        || (also().size() > 1 && archivePreviewMember(also()[1]))
        || (also().size() > 2 && archivePreviewMember(also()[2])));
    }
    // Past the Administrator/Council gate: does the record's own access let this person see it? (Kept apart from the gate,
    // so a rule checks the costly Council membership only once - Firestore allows 1000 steps per request.)
    function recordAllows(d) {
      return (d.get('access', '') == 'private' && keeper())
        || (d.get('access', '') == 'all' && anyone())
        || (d.get('access', '') == 'office' && manager())
        || (d.get('bodyId', '') != '' && inBody(d.bodyId))
        || mine(d.get('shownTo', ''));
    }
    function seesRecord(d) { return admin() || (councilMember() && recordAllows(d)); }
    function okRecord(d) {
      return d.title is string && d.title.size() > 0 && d.title.size() <= 150
        && d.access in ['all', 'body', 'office', 'private']
        && d.get('bodyId', '') is string && (d.access == 'body') == (d.get('bodyId', '') != '')
        && d.get('shownTo', '') is string && (d.get('shownTo', '') == '' || d.shownTo == d.get('aboutId', ''))
        && d.get('displayOnApplication', false) is bool;
    }
    // Council members manage only records they may see, and can't change one into something they couldn't see
    // (e.g. open up a private staff contract to themselves).
    function archiveRef(id) { return /databases/$(database)/documents/archive/$(id); }
    function managesRecord(id) { return admin() || (councilMember() && (!exists(archiveRef(id)) || recordAllows(get(archiveRef(id)).data))); }
    match /archive/{id} {
      allow read: if seesRecord(resource.data);
      allow create: if okRecord(request.resource.data)
        && (admin() || (councilMember() && !request.resource.data.get('displayOnApplication', false) && recordAllows(request.resource.data)));
      allow update: if okRecord(request.resource.data)
        && (admin() || (councilMember() && recordAllows(resource.data) && recordAllows(request.resource.data)
          && request.resource.data.get('displayOnApplication', false) == resource.data.get('displayOnApplication', false)));
      allow delete: if seesRecord(resource.data);
      // Parts are written before a new record, so a part of a record that doesn't exist yet may be written too.
      match /parts/{n} {
        allow read: if seesRecord(get(archiveRef(id)).data);
        allow create, update: if managesRecord(id) && request.resource.data.keys().hasOnly(['data'])
          && request.resource.data.data is string && request.resource.data.data.size() <= 950000;
        allow delete: if managesRecord(id);
      }
    }
    // A deliberately limited public copy of documents an Administrator selected for the membership form.
    // Private archive notes, access rules, staff details and source files are never copied here.
    match /applicationDocuments/{id} {
      allow read: if anyone();
      allow create, update: if admin() && request.resource.data.keys().hasOnly(['title', 'date', 'link', 'fileName', 'fileType', 'parts', 'fileVersion'])
        && request.resource.data.keys().hasAll(['title', 'date', 'link', 'fileName', 'fileType', 'parts', 'fileVersion'])
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 150
        && request.resource.data.date is string && request.resource.data.date.size() <= 10
        && request.resource.data.link is string && request.resource.data.link.size() <= 500
        && request.resource.data.fileName is string && request.resource.data.fileName.size() <= 150
        && request.resource.data.fileType is string && request.resource.data.fileType.size() <= 150
        && request.resource.data.parts is int && request.resource.data.parts >= 0 && request.resource.data.parts <= 24
        && request.resource.data.fileVersion is string && request.resource.data.fileVersion.size() <= 80
        && ((request.resource.data.parts == 0 && request.resource.data.fileVersion == '') || (request.resource.data.parts > 0 && request.resource.data.fileVersion.size() > 0));
      allow delete: if admin();
      match /files/{version}/parts/{n} {
        allow read: if anyone() && exists(/databases/$(database)/documents/applicationDocuments/$(id))
          && get(/databases/$(database)/documents/applicationDocuments/$(id)).data.fileVersion == version;
        allow create, update: if admin() && request.resource.data.keys().hasOnly(['data'])
          && request.resource.data.data is string && request.resource.data.data.size() <= 950000;
        allow delete: if admin();
      }
    }
    // Kept in step with Council membership in the Leadership page by Administrators and Pastors. Each entry names the
    // Council (a leadership group with "council" in its name) and is only allowed if the person really is in it.
    match /archivePreviewMembers/{id} {
      allow read: if manager() || isMe(id);
      allow create, update: if manager() && request.resource.data.keys().hasOnly(['personId', 'bodyId']) && request.resource.data.personId == id
        && request.resource.data.bodyId is string && request.resource.data.bodyId.size() > 0
        && exists(bodyRef(request.resource.data.bodyId))
        && get(bodyRef(request.resource.data.bodyId)).data.name.lower().matches('.*council.*')
        && id in get(bodyRef(request.resource.data.bodyId)).data.get('memberIds', []);
      allow delete: if manager();
    }
    function okArchivePreviewPart(d) {
      return d.keys().hasOnly(['data']) && d.data is string && d.data.size() <= 950000;
    }
    // A preview is an exact copy of a part of the record's own file, made by someone who may see that record.
    match /archivePreviews/{id}/parts/{n} {
      allow read: if seesRecord(get(archiveRef(id)).data);
      allow create, update: if okArchivePreviewPart(request.resource.data)
        && managesRecord(id)
        && exists(/databases/$(database)/documents/archive/$(id)/parts/$(n))
        && request.resource.data.data == get(/databases/$(database)/documents/archive/$(id)/parts/$(n)).data.data;
      allow delete: if managesRecord(id);
    }

    // ---------- the Library (js/library.js) ----------
    // Everyone signed in sees the items (books, DVDs, CDs...), their covers and the library's policy. The librarians
    // (Administrators, and the people named in settings librarianIds by an Administrator or the Senior Pastor) add items,
    // write the policy and record loans and returns. A loan is seen by the librarians and by the person who borrowed it.
    // A new loan needs the borrower's name and mobile number (a visitor not on the church's list has no personId).
    function librarian() {
      return admin() || (anyone() && meIn(get(/databases/$(database)/documents/settings/church).data.get('librarianIds', [])));
    }
    match /books/{id} {
      allow read: if anyone();
      allow create: if librarian() && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 150;
      allow update: if (librarian() && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 150)
        || (anyone() && onlyChanges(['out', 'lastClaimId']) && validLibraryClaim(id));
      allow delete: if librarian();
    }
    function okLoan(d) {
      return d.bookId is string && d.personId is string && d.get('mobile', '') is string && d.get('mobile', '').size() <= 30
        && (d.personId != '' || (d.get('visitor', false) == true && d.get('name', '') is string && d.get('name', '').size() > 0 && d.get('name', '').size() <= 100));
    }
    function pendingLibraryLoan(d) {
      return d.status == 'pending' && d.get('back', '') == '' && d.get('visitor', false) == false
        && d.personId is string && isMe(d.personId) && d.get('name', '') is string && d.get('name', '').size() > 0
        && d.get('name', '').size() <= 100 && d.get('mobile', '') is string && d.get('mobile', '').size() >= 7
        && d.get('mobile', '').size() <= 30
        && d.keys().hasOnly(['bookId', 'title', 'personId', 'name', 'mobile', 'visitor', 'out', 'due', 'back', 'note', 'status', 'requestedAt', 'createdAt', 'updatedAt']);
    }
    function validLibraryClaim(id) {
      let bookPath = /databases/$(database)/documents/books/$(id);
      let loanId = request.resource.data.get('lastClaimId', '');
      let loanPath = /databases/$(database)/documents/loans/$(loanId);
      return loanId is string && loanId.size() > 0 && existsAfter(loanPath)
        && getAfter(loanPath).data.bookId == id && getAfter(loanPath).data.status == 'pending'
        && isMe(getAfter(loanPath).data.personId) && getAfter(loanPath).data.get('back', '') == ''
        && getAfter(bookPath).data.out == resource.data.get('out', 0) + 1
        && getAfter(bookPath).data.out <= resource.data.get('copies', 1)
        && resource.data.get('removed', '') == '' && resource.data.get('repairing', false) == false;
    }
    function validClaimedBook(id) {
      let bookPath = /databases/$(database)/documents/books/$(request.resource.data.bookId);
      return existsAfter(bookPath) && getAfter(bookPath).data.lastClaimId == id
        && getAfter(bookPath).data.out == get(bookPath).data.get('out', 0) + 1
        && getAfter(bookPath).data.out <= get(bookPath).data.get('copies', 1)
        && get(bookPath).data.get('removed', '') == '' && get(bookPath).data.get('repairing', false) == false;
    }
    match /loans/{id} {
      allow read: if librarian() || mine(resource.data.get('personId', ''));
      allow create: if (librarian() && okLoan(request.resource.data) && request.resource.data.get('mobile', '').size() >= 7)
        || (anyone() && pendingLibraryLoan(request.resource.data) && validClaimedBook(id));
      allow update: if librarian() && okLoan(request.resource.data);
      allow delete: if librarian();
    }
    match /libraryDuplicateIgnores/{id} {
      allow read: if librarian();
      allow create, update: if librarian() && request.resource.data.keys().hasOnly(['pair', 'createdAt', 'updatedAt'])
        && request.resource.data.pair == id && id.size() <= 200;
      allow delete: if librarian();
    }
    match /covers/{id} {
      allow read: if anyone();
      allow create, update: if librarian() && request.resource.data.keys().hasOnly(['data', 'updatedAt'])
        && request.resource.data.data is string && request.resource.data.data.size() < 200000;
      allow delete: if librarian();
    }
    match /libraryPolicy/{doc} {
      allow read: if anyone();
      allow create, update: if doc == 'policy' && (librarian() || keeper())
        && request.resource.data.keys().hasOnly(['text', 'name', 'type', 'data', 'updatedAt', 'by'])
        && request.resource.data.get('text', '') is string && request.resource.data.get('text', '').size() <= 20000
        && request.resource.data.get('data', '') is string && request.resource.data.get('data', '').size() <= 900000;
      allow delete: if librarian() || keeper();
    }

    // What it takes to become a Church Partner (Me > Become a Church Partner): written, linked or attached by
    // Administrators, Pastors with the "settings" tick and the Senior Pastor (Rector); everyone signed in reads it.
    match /partnerInfo/{doc} {
      allow read: if anyone();
      allow create, update: if doc == 'requirements' && (may('settings') || rector())
        && request.resource.data.keys().hasOnly(['text', 'link', 'name', 'type', 'data', 'updatedAt', 'by'])
        && request.resource.data.get('text', '') is string && request.resource.data.get('text', '').size() <= 20000
        && request.resource.data.get('link', '') is string && request.resource.data.get('link', '').size() <= 500
        && request.resource.data.get('data', '') is string && request.resource.data.get('data', '').size() <= 900000;
      allow delete: if may('settings') || rector();
    }

    // ---------- parts not built yet (js/access.js PARTS, marked soon) ----------
    // Their sections are here so the people building them each fill in their own, without clashing. Closed to everyone
    // until then. Who may do what is decided in js/access.js; write the rules to match it (and tests/fake-firebase.js,
    // tests/rules.test.mjs) when the part is built.
    // ---------- Community board and Marketplace (js/community.js; docs/COMMUNITY-PLAN.md parts 2 and 3) ----------
    // Church Partners and staff (never attendees) see what is live and pin their own; it waits for a keeper first. Keepers
    // (js/access.js JOBS.keepers): the people in settings keepers.board / keepers.market once the church chooses, until then
    // the Administrators, the Pastors and the church secretary (settings rosterExtra); a keeper is never an attendee.
    // status: waiting -> live (approved, for 30 days), change (asked for a change), declined; done = sorted / sold.
    function communityPerson() { return anyone() && !attendee(); }
    function keepsPart(p) {
      let st = churchSettings();
      let chosen = st.get('keepers', {});
      return anyone() && (p in chosen ? meIn(chosen.get(p, [])) && !attendee()
        : isRole(['admin', 'pastor']) || (meIn(st.get('rosterExtra', [])) && !attendee()));
    }
    function in31Days(ms) { return ms is int && ms <= request.time.toMillis() + 31 * 86400000; }
    function okCommunity(p, d) {
      return d.title is string && d.title.size() > 0 && d.title.size() <= 80
        && d.get('body', '') is string && d.get('body', '').size() <= (p == 'market' ? 1000 : 600)
        && d.personId is string && d.get('name', '') is string && d.get('name', '').size() <= 60
        && d.status in ['waiting', 'live', 'change', 'declined', 'done'] && d.endsAt is int
        && d.get('renews', 0) is int && d.get('renews', 0) <= 2
        && d.get('note', '') is string && d.get('note', '').size() <= 300 && d.get('by', '') is string && d.get('by', '').size() <= 60
        && d.get('reports', []) is list && d.get('reports', []).size() <= 50
        && (p == 'board'
          ? d.keys().hasOnly(['kind', 'title', 'body', 'phone', 'personId', 'name', 'status', 'endsAt', 'renews', 'note', 'by', 'decidedAt', 'doneAt', 'reports', 'createdAt', 'updatedAt'])
            && d.kind in ['need', 'offer', 'notice', 'thanks'] && d.get('phone', '') is string && d.get('phone', '').size() <= 30
          : d.keys().hasOnly(['kind', 'title', 'body', 'personId', 'name', 'status', 'endsAt', 'renews', 'note', 'by', 'decidedAt', 'doneAt', 'reports', 'createdAt', 'updatedAt', 'price', 'offer', 'condition', 'category', 'area', 'photos', 'thumb'])
            && d.kind in ['sale', 'wanted', 'free'] && d.get('price', 0) is number && d.get('price', 0) >= 0
            && d.get('condition', '') is string && d.get('condition', '').size() <= 20 && d.get('category', '') is string && d.get('category', '').size() <= 20
            && d.get('area', '') is string && d.get('area', '').size() <= 60
            && d.get('photos', 0) is int && d.get('photos', 0) <= 3 && d.get('thumb', '') is string && d.get('thumb', '').size() <= 60000);
    }
    function seesItem(p, d) { return communityPerson() && (d.status in ['live', 'done'] || isMe(d.personId) || keepsPart(p)); }
    // Cheap checks first, and the long one (okCommunity) last: Firestore allows 1000 steps per request.
    function newItem(p, d) {
      return d.status == 'waiting' && d.get('note', '') == '' && d.get('renews', 0) == 0 && d.get('reports', []).size() == 0
        && in31Days(d.endsAt) && communityPerson() && isMe(d.personId) && okCommunity(p, d);
    }
    // The poster: a change goes back to the keepers; or sorted / sold, renewed (twice at most), or a lower price.
    function posterChanges(p, b, d) {
      return d.personId == b.personId && (
        (d.status == 'waiting' && in31Days(d.endsAt) && d.get('renews', 0) == b.get('renews', 0) && d.get('reports', []).size() == 0)
        || (b.status == 'live' && d.status == 'done' && onlyChanges(['status', 'doneAt', 'updatedAt']))
        || (b.status == 'live' && onlyChanges(['endsAt', 'renews', 'updatedAt']) && d.get('renews', 0) == b.get('renews', 0) + 1 && in31Days(d.endsAt))
        || (p == 'market' && b.status == 'live' && onlyChanges(['price', 'updatedAt']) && d.get('price', 0) < b.get('price', 0)))
        && anyone() && isMe(b.personId);
    }
    // A keeper decides (and may clear reports); anyone who sees a live one may add themselves to its reports.
    function othersChange(p, b, d) {
      return (onlyChanges(['status', 'note', 'by', 'decidedAt', 'endsAt', 'reports', 'updatedAt']) && d.status in ['live', 'change', 'declined'] && in31Days(d.endsAt) && keepsPart(p))
        || (b.status == 'live' && onlyChanges(['reports', 'updatedAt']) && d.reports.hasAll(b.get('reports', []))
          && d.reports.removeAll(b.get('reports', [])).hasOnly(myIds()) && communityPerson());
    }
    function changesItem(p, b, d) { return (posterChanges(p, b, d) || othersChange(p, b, d)) && okCommunity(p, d); }
    match /board/{id} {
      allow read: if seesItem('board', resource.data);
      allow create: if newItem('board', request.resource.data);
      allow update: if changesItem('board', resource.data, request.resource.data);
      allow delete: if (anyone() && isMe(resource.data.personId)) || keepsPart('board');
    }
    match /market/{id} {
      allow read: if seesItem('market', resource.data);
      allow create: if newItem('market', request.resource.data);
      allow update: if changesItem('market', resource.data, request.resource.data);
      allow delete: if (anyone() && isMe(resource.data.personId)) || keepsPart('market');
    }
    // A listing's photos (up to 3 small pictures), apart so the list doesn't download them: seen by whoever sees the listing;
    // written by its poster while it waits for a keeper (new photos are checked like everything else).
    function listingRef(id) { return /databases/$(database)/documents/market/$(id); }
    match /marketPhotos/{id} {
      allow read: if seesItem('market', get(listingRef(id)).data);
      allow create, update: if anyone() && isMe(getAfter(listingRef(id)).data.personId) && getAfter(listingRef(id)).data.status == 'waiting'
        && request.resource.data.keys().hasOnly(['data', 'updatedAt', 'createdAt']) && request.resource.data.data is list && request.resource.data.data.size() <= 3;
      allow delete: if keepsPart('market') || (anyone() && exists(listingRef(id)) && isMe(get(listingRef(id)).data.personId));
    }
    // ---------- Events (js/events.js; docs/COMMUNITY-PLAN.md part 1) ----------
    // Organisers (js/access.js JOBS.organisers): the people in settings organisers.events once the church chooses, until then
    // the Administrators, the Pastors and the church secretary (settings rosterExtra); never an attendee. They put events up,
    // see every sign-up and write to everyone coming. Everyone signed in sees the events for everyone; Church Partners and
    // staff also those for Church Partners. A person signs up themselves (and people in their household); the email robot
    // reads the sign-ups to send reminders by email to those who asked, and notes which it sent (mailed).
    function eventRef(id) { return /databases/$(database)/documents/events/$(id); }
    function organises() {
      let st = churchSettings();
      let chosen = st.get('organisers', {});
      return anyone() && ('events' in chosen ? meIn(chosen.get('events', [])) && !attendee()
        : isRole(['admin', 'pastor']) || (meIn(st.get('rosterExtra', [])) && !attendee()));
    }
    function okDay(s) { return s is string && s.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'); }
    function okClock(s) { return s is string && (s == '' || s.matches('[0-2][0-9]:[0-5][0-9]')); }
    function okEvent(d) {
      return d.keys().hasOnly(['title', 'about', 'date', 'time', 'end', 'place', 'address', 'who', 'signup', 'closes', 'guests', 'email', 'status', 'byId', 'byName', 'createdAt', 'updatedAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 80 && d.get('about', '') is string && d.get('about', '').size() <= 1500
        && okDay(d.date) && okClock(d.time) && d.time != '' && okClock(d.get('end', ''))
        && d.get('place', '') is string && d.get('place', '').size() <= 80 && d.get('address', '') is string && d.get('address', '').size() <= 160
        && d.who in ['all', 'partners'] && d.signup is bool && (d.get('closes', '') == '' || okDay(d.get('closes', '')))
        && d.get('guests', 0) is int && d.get('guests', 0) >= 0 && d.get('guests', 0) <= 10 && d.get('email', false) is bool
        && d.status in ['live', 'cancelled'] && d.get('byId', '') is string && d.get('byName', '') is string && d.get('byName', '').size() <= 100;
    }
    function seesEvent(d) { return anyone() && (d.get('who', 'all') == 'all' || !attendee() || organises()); }
    match /events/{id} {
      allow read: if robot() || seesEvent(resource.data);
      allow create, update: if organises() && okEvent(request.resource.data);
      allow delete: if organises();
    }
    function okSignup(id, d) {
      return d.keys().hasOnly(['eventId', 'by', 'people', 'names', 'guests', 'email', 'lang', 'mailed', 'createdAt', 'updatedAt'])
        && d.eventId is string && d.by is string && id == d.eventId + '_' + d.by
        && d.people is list && d.people.size() > 0 && d.people.size() <= 12 && d.get('names', []) is list && d.get('names', []).size() <= 12
        && d.get('guests', 0) is int && d.get('guests', 0) >= 0 && d.get('guests', 0) <= 10
        && d.get('email', '') is string && d.get('email', '').size() <= 200 && d.get('lang', '') is string && d.get('lang', '').size() <= 10
        && d.get('mailed', []) is list && d.get('mailed', []).size() <= 2;
    }
    // Signing up (or changing it): only while the event is on and takes sign-ups, and never changing what the robot noted
    function mayJoin(d) {
      let e = get(eventRef(d.eventId)).data;
      return e.signup == true && e.status == 'live' && seesEvent(e) && d.get('guests', 0) <= e.get('guests', 0)
        && (d.get('email', '') == '' || e.get('email', false) == true);
    }
    match /eventSignups/{id} {
      allow read: if robot() || (anyone() && (isMe(resource.data.by) || meIn(resource.data.get('people', [])))) || organises();
      allow create: if anyone() && isMe(request.resource.data.by) && okSignup(id, request.resource.data)
        && request.resource.data.get('mailed', []).size() == 0 && mayJoin(request.resource.data);
      allow update: if (robot() && onlyChanges(['mailed', 'updatedAt']) && request.resource.data.get('mailed', []) is list && request.resource.data.get('mailed', []).size() <= 2)
        || (anyone() && isMe(resource.data.by) && okSignup(id, request.resource.data) && request.resource.data.by == resource.data.by
          && request.resource.data.get('mailed', []) == resource.data.get('mailed', []) && mayJoin(request.resource.data))
        || (organises() && okSignup(id, request.resource.data));
      allow delete: if (anyone() && isMe(resource.data.by)) || organises();
    }
    // Subscription (js/mod-support.js; tasks 061, 067): the church's record of what it has paid, written by the
    // Church & Trellis office only. Today the Subscription page keeps its choices in settings/church.
    match /subscription/{doc} { allow read, write: if false; }

    // ---------- POPIA registers (Administrators, and Pastors with "privacy") ----------
    match /dsr/{id} { allow read, write: if may('privacy'); }
    match /breaches/{id} { allow read, write: if may('privacy'); }
    // The day's email prompts already sent or set aside (Home): Administrators only, cleared each day
    match /emailPrompts/{id} { allow read, write: if may('settings'); }
    // Audit log: everyone signed in can add an entry about themselves; only Administrators read it; nobody changes it.
    match /audit/{id} {
      allow read: if may('privacy');
      allow create: if anyone()
        && request.resource.data.byEmail == request.auth.token.email.lower()
        && request.resource.data.ts == request.time;
      allow update, delete: if false;
    }
  }
}
