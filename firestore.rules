rules_version = '2';

// Church Hub - who may read and write what (POPIA "security safeguards", s19).
// Paste this whole file into Firebase console > Firestore Database > Rules > Publish.
// Tested by tests/rules.test.mjs (runs automatically on GitHub after every change).
//
// How access works:
// - People sign in with Google or an email link. Their email address must be verified.
// - roles/{email} says what they may do: admin, pastor, rosters, kids or member, and which person record is theirs.
//   Only Administrators can change roles (and Pastors with the "access" tick, for the smaller roles). No roles document = no access at all.
// - People who share one email address (often a couple) share one sign-in: their roles document lists everyone's roles
//   (roles) and the other people it is for (also, at most 3). After signing in they choose who is using Church Hub;
//   the rules let the sign-in do what any of them may do (whoever reads that inbox can sign in as any of them anyway).
// - Medical notes (children) are for Children's ministry only. Pastoral notes are for Pastors only.
//   Administrators cannot read either; they can only delete them when someone asks to be deleted (POPIA s24).
// - Members see their own details, their own serving and leave, and the church directory
//   (only people who agreed to be in it).

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- who is asking ----------
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function roleRef() { return /databases/$(database)/documents/roles/$(request.auth.token.email.lower()); }
    function hasRole() { return signedIn() && exists(roleRef()); }
    function access() { return get(roleRef()).data; }
    function myRoles() { return access().get('roles', [access().role]); }
    function isRole(list) { return hasRole() && myRoles().hasAny(list); }
    function admin() { return isRole(['admin']); }
    function staff() { return isRole(['admin', 'pastor', 'rosters', 'kids']); }
    function anyone() { return isRole(['admin', 'pastor', 'rosters', 'kids', 'member']); }
    function me() { return access().get('personId', ''); }
    // The other people who share this sign-in (a shared email address), and "is this one of us?"
    function also() { return access().get('also', []); }
    function myIds() { return [me()].concat(also()); }
    function isMe(pid) {
      return pid != '' && (pid == me() || (also().size() > 0 && pid == also()[0])
        || (also().size() > 1 && pid == also()[1]) || (also().size() > 2 && pid == also()[2]));
    }
    function meIn(list) {
      return (me() != '' && me() in list) || (also().size() > 0 && also()[0] in list)
        || (also().size() > 1 && also()[1] in list) || (also().size() > 2 && also()[2] in list);
    }
    function mine(personId) { return anyone() && isMe(personId); }
    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    // What Pastors can do (Settings): an Administrator ticks abilities, which Church Hub copies onto each Pastor's
    // access-list entry as "can". The Senior Pastor (Rector), if one is chosen, gets their own ticks (seniorCan). may('leave') is true for Administrators, and for Pastors with that tick.
    // Abilities: settings, access, people, idnumbers, leave, rosters, privacy, import, words.
    function may(x) { return admin() || (isRole(['pastor']) && x in access().get('can', [])); }
    function rosterer() { return isRole(['admin', 'rosters']) || may('rosters'); }
    // The stand-in leave approver, between the dates on their access-list entry (Leave > Approvals > Stand-in approver)
    function standIn() { return anyone() && access().get('standInFrom', 0) <= request.time.toMillis() && request.time.toMillis() <= access().get('standInTo', 0); }
    // The roles a Pastor with "access" may give or take away (never Administrator or Pastor, never abilities)
    function smallRole(r) { return r in ['rosters', 'kids', 'member']; }
    function smallRoles(d) { return smallRole(d.role) && d.get('roles', [d.role]).hasOnly(['rosters', 'kids', 'member']); }
    // A roles document: its roles, and at most 3 other people sharing the sign-in
    function okRoles(d) {
      return d.get('roles', []).hasOnly(['admin', 'pastor', 'rosters', 'kids', 'member'])
        && d.get('also', []) is list && d.get('also', []).size() <= 3;
    }
    // The Elvanto robot (GitHub Actions) signs in with its own account. Its access-list entry names its account ID (uid),
    // so nobody else can use that email address. It can only read church settings and work on the Elvanto list.
    function robot() {
      return request.auth != null && request.auth.token.email != null && exists(roleRef())
        && access().role == 'robot' && access().get('uid', '') == request.auth.uid;
    }

    // ---------- access list (Administrators manage it from People > Edit details) ----------
    match /roles/{email} {
      allow read: if signedIn() && (email == request.auth.token.email.lower() || may('access'));
      allow create: if (admin() && request.resource.data.role in ['admin', 'pastor', 'rosters', 'kids', 'member', 'robot'] && okRoles(request.resource.data))
        || (may('access') && smallRoles(request.resource.data) && okRoles(request.resource.data) && request.resource.data.keys().hasOnly(['role', 'personId', 'name', 'roles', 'also', 'people']));
      allow update: if (admin() && request.resource.data.role in ['admin', 'pastor', 'rosters', 'kids', 'member', 'robot'] && okRoles(request.resource.data))
        || (may('access') && smallRoles(resource.data) && smallRoles(request.resource.data) && okRoles(request.resource.data) && request.resource.data.keys().hasOnly(['role', 'personId', 'name', 'roles', 'also', 'people']))
        || (may('leave') && onlyChanges(['standInFrom', 'standInTo']) && request.resource.data.standInFrom is int && request.resource.data.standInTo is int);
      allow delete: if admin() || (may('access') && smallRoles(resource.data));
    }

    // ---------- church settings ----------
    match /settings/{doc} {
      // Older versions kept brochure wording here. Keep it private until an Administrator moves it to brochures/church.
      allow read: if admin()
        || (anyone() && !resource.data.keys().hasAny(['brochures']))
        || (robot() && !resource.data.keys().hasAny(['brochures']));
      allow create: if admin() && !request.resource.data.keys().hasAny(['brochures']);
      allow delete: if admin();
      // A Pastor with "settings" may change everything except what Pastors can do, what the Senior Pastor can do,
      // and who the Senior Pastor is (only an Administrator sets those)
      // The Senior Pastor may choose the librarians and record the review date, and change nothing else here
      allow update: if (admin() && !request.resource.data.keys().hasAny(['brochures'])) || (may('settings')
        && request.resource.data.get('pastorCan', []) == resource.data.get('pastorCan', [])
        && request.resource.data.get('seniorCan', []) == resource.data.get('seniorCan', [])
        && request.resource.data.get('seniorPastorId', '') == resource.data.get('seniorPastorId', '')
        && request.resource.data.get('brochures', null) == resource.data.get('brochures', null))
        || (isRole(['pastor']) && isMe(resource.data.get('seniorPastorId', ''))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['librarianIds', 'librarianReviewedAt'])
          && request.resource.data.get('librarianIds', []) is list
          && request.resource.data.get('librarianReviewedAt', '') is string
          && request.resource.data.get('librarianReviewedAt', '').size() >= 20
          && request.resource.data.get('librarianReviewedAt', '').size() <= 40);
    }
    // Brochure wording is visible and editable only by Administrators.
    match /brochures/{id} {
      allow read, write: if admin() && id == 'church';
    }

    // ---------- people ----------
    // Name, family and contact details. Members may correct their own name and contact details.
    match /people/{id} {
      allow read: if staff() || mine(id);
      allow create: if isRole(['admin', 'pastor']);
      allow update: if isRole(['admin', 'pastor'])
        || (mine(id) && onlyChanges(['firstName', 'lastName', 'preferredName', 'email', 'mobile', 'photo', 'updatedAt']))
        || (isRole(['kids']) && resource.data.familyRole == 'child' && onlyChanges(['photo', 'updatedAt']));
      allow delete: if may('people');
    }
    // Birthday, key dates, staff details. Children's ministry sees children's details only.
    match /details/{id} {
      allow read: if isRole(['admin', 'pastor']) || mine(id)
        || (isRole(['kids']) && resource.data.familyRole == 'child');
      allow write: if isRole(['admin', 'pastor']);
    }
    // Children's medical notes and allergies (special personal information): Children's ministry only.
    match /medical/{id} {
      allow read, create, update: if isRole(['kids']);
      allow delete: if isRole(['kids']) || may('people');
    }
    // Pastoral notes, one document per person: Pastors only.
    match /notes/{personId} {
      allow read, create, update: if isRole(['pastor']);
      allow delete: if isRole(['pastor']) || may('people');
    }
    // Adults responsible for a child (parents, guardians, carers, trusted collectors): who may consent, gets messages, may collect.
    // Administrators, Pastors and Children's ministry manage them; an adult may see the links that name them.
    match /guardians/{id} {
      allow read: if isRole(['admin', 'pastor', 'kids']) || mine(resource.data.adultId);
      allow write: if isRole(['admin', 'pastor', 'kids']);
    }
    // Not allowed to collect a child (e.g. a court order): restricted, views are logged by the app.
    match /noCollect/{id} {
      allow read, write: if isRole(['admin', 'pastor', 'kids']);
    }
    // Contact details, for adults who agreed to share them. directory: everyone signed in can read it - their name and photo,
    // plus only what Settings lets Church Partners see (mobile, email, address, spouse). contacts: staff and leaders only -
    // home address and spouse, when Settings lets Roster coordinators or Children's ministry see them.
    match /directory/{id} {
      allow read: if anyone();
      allow create, update: if (isRole(['admin', 'pastor']) || mine(id))
        && request.resource.data.keys().hasOnly(['firstName', 'lastName', 'preferredName', 'mobile', 'email', 'shareAddress', 'shareSpouse', 'photo', 'care']);
      allow delete: if isRole(['admin', 'pastor']) || mine(id);
    }
    match /contacts/{id} {
      allow read: if staff();
      allow create, update: if (isRole(['admin', 'pastor']) || mine(id))
        && request.resource.data.keys().hasOnly(['shareAddress', 'shareSpouse']);
      allow delete: if isRole(['admin', 'pastor']) || mine(id);
    }
    // Photos, one small picture per person. Adults: staff, the person, and members when the adult is in the directory.
    // Children: Administrators, Pastors and Children's ministry only. Administrators and Pastors add photos; Children's
    // ministry for children; anyone for themselves (adults).
    function isChild(id) { return get(/databases/$(database)/documents/people/$(id)).data.get('familyRole', '') == 'child'; }
    match /photos/{id} {
      allow read: if isChild(id) ? isRole(['admin', 'pastor', 'kids'])
        : (staff() || mine(id) || (anyone() && exists(/databases/$(database)/documents/directory/$(id))));
      allow create, update: if request.resource.data.keys().hasOnly(['data', 'updatedAt'])
        && request.resource.data.data is string && request.resource.data.data.size() < 200000
        && (isRole(['admin', 'pastor']) || (isChild(id) ? isRole(['kids']) : mine(id)));
      allow delete: if isRole(['admin', 'pastor']) || (isChild(id) ? isRole(['kids']) : mine(id));
    }
    // Church office notes (e.g. brought across from Elvanto): Administrators and Pastors. Pastoral notes stay Pastors only.
    match /officeNotes/{personId} {
      allow read, write: if isRole(['admin', 'pastor']);
    }
    // ID numbers: Administrators only (and the person may see their own). Kept apart; every view is logged by the app.
    match /idNumbers/{personId} {
      allow read: if may('idnumbers') || mine(personId);
      allow create, update: if may('idnumbers') && request.resource.data.keys().hasOnly(['value', 'updatedAt'])
        && request.resource.data.value is string && request.resource.data.value.size() <= 20;
      // Someone applying to become a Church Partner may give their own ID number once (never change one already kept)
      allow create: if mine(personId) && request.resource.data.keys().hasOnly(['value', 'updatedAt'])
        && request.resource.data.value is string && request.resource.data.value.size() <= 20;
      allow delete: if may('idnumbers') || may('people');
    }
    match /families/{id} {
      allow read: if staff();
      allow write: if isRole(['admin', 'pastor']);
    }
    // Consent register. Members record their own choices; Children's ministry sees medical and photo consent.
    match /consents/{id} {
      allow read: if isRole(['admin', 'pastor']) || mine(resource.data.personId)
        || (isRole(['kids']) && resource.data.purpose.matches('Children.s medical notes|Photos'));
      allow create: if isRole(['admin', 'pastor'])
        || (mine(request.resource.data.personId) && request.resource.data.method == 'Changed in the app');
      allow update: if isRole(['admin', 'pastor'])
        || (mine(resource.data.personId) && onlyChanges(['withdrawnAt', 'updatedAt']));
      allow delete: if may('people');
    }

    // ---------- rosters ----------
    match /teams/{id} { allow read: if anyone(); allow write: if rosterer(); }
    match /positions/{id} { allow read: if anyone(); allow write: if rosterer(); }
    match /services/{id} { allow read: if anyone(); allow write: if rosterer(); }
    match /skills/{id} {
      allow read: if staff() || mine(resource.data.personId);
      allow write: if rosterer();
    }
    // Members can accept or decline their own turns, nothing else.
    match /assignments/{id} {
      allow read: if staff() || mine(resource.data.personId);
      allow create, delete: if rosterer();
      allow update: if rosterer()
        || (mine(resource.data.personId) && onlyChanges(['status', 'updatedAt'])
            && request.resource.data.status in ['accepted', 'declined']);
    }
    // Serve together / keep apart. Members may set up groups they are part of.
    match /groups/{id} {
      allow read: if staff() || (anyone() && meIn(resource.data.memberIds));
      allow create: if rosterer() || (anyone() && meIn(request.resource.data.memberIds));
      allow update: if rosterer()
        || (anyone() && meIn(resource.data.memberIds) && meIn(request.resource.data.memberIds));
      allow delete: if rosterer() || (anyone() && meIn(resource.data.memberIds));
    }
    // Administrator-managed groups contain membership IDs only, never contact details.
    match /customGroups/{id} {
      allow read: if admin() || (anyone() && (resource.data.visibility == 'church' || meIn(resource.data.memberIds)));
      allow create, update: if admin() && request.resource.data.keys().hasOnly(['name', 'description', 'memberIds', 'visibility', 'createdAt', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.description is string && request.resource.data.description.size() <= 500
        && request.resource.data.memberIds is list && request.resource.data.memberIds.size() <= 5000
        && request.resource.data.visibility in ['church', 'members']
        && (!request.resource.data.keys().hasAny(['createdAt']) || request.resource.data.createdAt is string)
        && (!request.resource.data.keys().hasAny(['updatedAt']) || request.resource.data.updatedAt is string);
      allow delete: if admin();
    }
    // Care groups. Administrators and Pastors set them up; a group's carers (leaderIds) may add and remove its members.
    // Members read their own group, and each member's card in it (share/{person}): their name, and the rest only
    // if they agreed (consent "Care group"). Each person keeps their own card up to date.
    function careRef(gid) { return /databases/$(database)/documents/careGroups/$(gid); }
    function inCare(gid) { return anyone() && meIn(get(careRef(gid)).data.get('memberIds', [])); }
    function leadsCare(gid) { return anyone() && meIn(get(careRef(gid)).data.get('leaderIds', [])); }
    // Settings -> Who can see what: Roster coordinators and Children's ministry may see every group and who is in it
    // (settings seeCare), but not the members' cards
    function seeCare() { return get(/databases/$(database)/documents/settings/church).data.get('seeCare', []); }
    // Settings -> Who can see what: may members see everyone in their own group (seeCareOwn, on unless switched off)?
    // When off they see their carers' cards and their own; the carers still see everyone in their group.
    function careOwn() { return get(/databases/$(database)/documents/settings/church).data.get('seeCareOwn', true) != false; }
    function careCarer(gid, pid) { return pid in get(careRef(gid)).data.get('leaderIds', []); }
    function seesCare() { return (isRole(['rosters']) && 'rosters' in seeCare()) || (isRole(['kids']) && 'kids' in seeCare()); }
    match /careGroups/{gid} {
      allow read: if isRole(['admin', 'pastor']) || seesCare() || (anyone() && meIn(resource.data.get('memberIds', [])));
      allow create, delete: if isRole(['admin', 'pastor']);
      allow update: if isRole(['admin', 'pastor'])
        || (anyone() && meIn(resource.data.get('leaderIds', [])) && onlyChanges(['memberIds', 'names', 'updatedAt'])
            && meIn(request.resource.data.memberIds) && request.resource.data.memberIds.hasAll(resource.data.get('leaderIds', [])))
        // a life group's leaders (type life: Bible studies, midweek groups) may also name their group and say when and where it meets
        || (anyone() && resource.data.get('type', '') == 'life' && meIn(resource.data.get('leaderIds', [])) && onlyChanges(['name', 'memberIds', 'names', 'when', 'venue', 'roles', 'updatedAt'])
            && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
            && meIn(request.resource.data.memberIds) && request.resource.data.memberIds.hasAll(resource.data.get('leaderIds', [])));
      match /share/{pid} {
        allow read: if isRole(['admin', 'pastor']) || (inCare(gid) && (careOwn() || mine(pid) || leadsCare(gid) || careCarer(gid, pid)));
        allow create, update: if (isRole(['admin', 'pastor']) || (mine(pid) && inCare(gid)))
          && request.resource.data.keys().hasOnly(['firstName', 'lastName', 'preferredName', 'ok', 'mobile', 'email', 'address', 'birthday', 'photo', 'leader', 'updatedAt', 'createdAt'])
          && (request.resource.data.get('photo', '') is string) && request.resource.data.get('photo', '').size() < 40000;
        allow delete: if isRole(['admin', 'pastor']) || mine(pid) || leadsCare(gid);
      }
    }
    // Messages inside the app (js/messages.js). A message lists the people it went to (to), worked out when it was sent.
    // Administrators and Pastors send to anyone (a group, or people they tick: kind people); a care group's carers (or a life group's leaders: kind life) to
    // their group, a message group's leaders to theirs and anyone on a leadership group (kind leaders) to that group - all of
    // it, or only some of its people (to is checked).
    // Read by the people it went to, its sender, Administrators and Pastors. The only change anyone else may make is to
    // add themselves to readBy (they opened it). The sender, Administrators and Pastors may delete it.
    function msgGroupRef(gid) { return /databases/$(database)/documents/msgGroups/$(gid); }
    function manager() { return isRole(['admin', 'pastor']); }
    function maySendTo(m) {
      return manager()
        || ((m.kind == 'care' || m.kind == 'life') && meIn(get(careRef(m.groupId)).data.get('leaderIds', [])) && m.to.hasOnly(get(careRef(m.groupId)).data.get('memberIds', [])))
        || (m.kind == 'group' && meIn(get(msgGroupRef(m.groupId)).data.get('leaderIds', [])) && m.to.hasOnly(get(msgGroupRef(m.groupId)).data.get('memberIds', []).concat(get(msgGroupRef(m.groupId)).data.get('leaderIds', []))))
        || (m.kind == 'leaders' && meIn(get(/databases/$(database)/documents/leaderBodies/$(m.groupId)).data.get('memberIds', [])) && m.to.hasOnly(get(/databases/$(database)/documents/leaderBodies/$(m.groupId)).data.get('memberIds', [])));
    }
    match /messages/{id} {
      allow read: if manager() || (anyone() && (meIn(resource.data.get('to', [])) || isMe(resource.data.get('fromId', ''))));
      allow create: if anyone() && isMe(request.resource.data.fromId)
        && request.resource.data.keys().hasOnly(['kind', 'groupId', 'audience', 'some', 'title', 'body', 'fromId', 'fromName', 'to', 'readBy', 'createdAt', 'updatedAt'])
        && request.resource.data.kind in ['care', 'life', 'group', 'leaders', 'staff', 'partners', 'people']
        && request.resource.data.get('some', false) is bool
        && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 4000
        && request.resource.data.get('title', '') is string && request.resource.data.get('title', '').size() <= 120
        && request.resource.data.to is list && request.resource.data.to.size() > 0 && request.resource.data.to.size() <= 3000
        && request.resource.data.readBy is list && request.resource.data.readBy.hasOnly(myIds())
        && maySendTo(request.resource.data);
      allow update: if anyone() && meIn(resource.data.get('to', [])) && onlyChanges(['readBy'])
        && request.resource.data.readBy.hasAll(resource.data.get('readBy', []))
        && request.resource.data.readBy.removeAll(resource.data.get('readBy', [])).hasOnly(myIds());
      allow delete: if manager() || (anyone() && isMe(resource.data.get('fromId', '')));
    }
    // Message groups (e.g. Worship team leaders): Administrators and Pastors set them up; members see the groups they are in.
    match /msgGroups/{gid} {
      allow read: if manager() || (anyone() && meIn(resource.data.get('memberIds', [])));
      allow write: if manager();
    }
    // Offers to serve: a person asks to join a position, change how often, or stop; the roster coordinator answers.
    match /serveOffers/{id} {
      allow read: if rosterer() || mine(resource.data.personId);
      allow create: if rosterer()
        || (mine(request.resource.data.personId) && request.resource.data.status == 'waiting'
            && request.resource.data.kind in ['join', 'change', 'stop']
            && request.resource.data.keys().hasOnly(['personId', 'positionId', 'kind', 'frequency', 'times', 'note', 'status', 'createdAt', 'updatedAt']));
      allow update: if rosterer();
      allow delete: if rosterer() || mine(resource.data.personId);
    }
    // Family details people ask the church office to change (marital status, wedding anniversary, spouse, children).
    // Nothing changes until an Administrator checks the request and makes the changes.
    match /detailChanges/{id} {
      allow read: if may('people') || mine(resource.data.personId);
      allow create: if may('people')
        || (mine(request.resource.data.personId) && request.resource.data.status == 'waiting'
            && request.resource.data.keys().hasOnly(['personId', 'maritalStatus', 'anniversary', 'spouse', 'children', 'note', 'status', 'createdAt', 'updatedAt']));
      allow update: if may('people');
      allow delete: if may('people') || mine(resource.data.personId);
    }
    // Applications to become a Church Partner, sent from the person's own page. Administrators and Pastors read and answer
    // them (how someone came to faith is religious information: special personal information, kept for the church's members).
    match /partnerApps/{id} {
      allow read: if isRole(['admin', 'pastor']) || mine(resource.data.personId);
      allow create: if isRole(['admin', 'pastor'])
        || (mine(request.resource.data.personId) && request.resource.data.status == 'waiting'
            && request.resource.data.keys().hasOnly(['personId', 'spouse', 'anniversary', 'children', 'since', 'faith', 'story', 'otherChurch', 'otherWhich',
              'classOk', 'study', 'questions', 'serve', 'declaration', 'loyalty', 'birthDate', 'directory', 'status', 'createdAt', 'updatedAt']));
      allow update: if isRole(['admin', 'pastor']);
      allow delete: if isRole(['admin', 'pastor']) || mine(resource.data.personId);
    }
    // Away dates people enter themselves.
    match /blockouts/{id} {
      allow read: if staff() || mine(resource.data.personId);
      allow create, update: if rosterer() || mine(request.resource.data.personId);
      allow delete: if rosterer() || mine(resource.data.personId);
    }
    // Approved leave as plain dates (no leave type or reason), so rosters can skip people who are away.
    match /away/{id} {
      allow read: if anyone();
      allow create, update: if may('leave')
        || ((mine(request.resource.data.personId) || standIn()) && request.resource.data.keys().hasOnly(['personId', 'from', 'to']));
      allow delete: if may('leave') || mine(resource.data.personId);
    }

    // ---------- leave (same rules as Leave Manager) ----------
    match /leave/{doc} {
      allow read: if anyone();
      allow write: if may('leave');
    }
    // Staff see and request their own leave; only Administrators approve.
    match /leaveRequests/{id} {
      allow read: if may('leave') || standIn() || mine(resource.data.staffId);
      allow create: if may('leave') || (mine(request.resource.data.staffId) && (
        request.resource.data.status == 'Pending'
        || (request.resource.data.status == 'Approved'
            && request.resource.data.type in get(/databases/$(database)/documents/leave/config).data.autoApprove)));
      allow update: if may('leave')
        || (mine(resource.data.staffId) && request.resource.data.status == 'Cancelled'
            && onlyChanges(['status', 'cancelledBy']))
        || (standIn() && !isMe(resource.data.staffId) && resource.data.status == 'Pending'
            && request.resource.data.status in ['Approved', 'Declined'] && onlyChanges(['status', 'decidedBy', 'decidedOn']));
      allow delete: if may('leave');
    }
    match /leaveAdjustments/{id} {
      allow read: if may('leave') || mine(resource.data.staffId);
      allow write: if may('leave');
    }

    // ---------- Elvanto: approved leave as Unavailable Volunteers (names and dates only) ----------
    // Administrators manage the list; staff add entries for their own leave (e.g. cancelling approved leave);
    // the robot reads it and reports what it did.
    match /elvantoSync/{id} {
      allow read: if may('import') || robot() || mine(resource.data.personId);
      allow create: if may('import')
        || ((mine(request.resource.data.personId) || standIn()) && request.resource.data.status == 'Waiting'
            && request.resource.data.keys().hasOnly(['personId', 'name', 'start', 'end', 'want', 'have', 'haveNote', 'status', 'note', 'createdAt', 'updatedAt']));
      allow update: if may('import')
        || ((mine(resource.data.personId) || standIn()) && request.resource.data.personId == resource.data.personId && request.resource.data.status == 'Waiting'
            && onlyChanges(['name', 'start', 'end', 'want', 'status', 'note', 'updatedAt']))
        || (robot() && onlyChanges(['status', 'note', 'have', 'haveNote', 'doneAt']));
      allow delete: if may('import');
    }
    // What the robot found in Elvanto (nightly, when switched on): names and dates of Unavailable Volunteers, for an
    // Administrator to check and apply in Church Hub (Import). The robot writes it; only Administrators read or delete it.
    match /elvantoFound/{id} {
      allow read, delete: if may('import');
      allow create, update: if robot() && request.resource.data.keys().hasOnly(['readAt', 'entries', 'rows', 'unread', 'pages', 'applied']);
    }
    match /robotStatus/{id} {
      allow read: if may('import');
      allow write: if robot();
    }

    // ---------- translations ----------
    // Anyone signed in may suggest better wording in a language. The people who check a language (the languages on their
    // access-list entry, set by an Administrator) and Administrators decide; approved wording goes into words/{language},
    // which everyone signed in reads. A suggestion keeps who sent it, so the checker can thank or ask them.
    function checks(lang) { return anyone() && lang in access().get('langs', []); }
    match /words/{lang} {
      allow read: if anyone();
      allow create, update: if (may('words') || checks(lang)) && request.resource.data.keys().hasOnly(['words', 'updatedAt', 'createdAt', 'by'])
        && request.resource.data.words is map;
      allow delete: if may('words') || checks(lang);
    }
    match /wordIdeas/{id} {
      allow read: if may('words') || mine(resource.data.personId) || checks(resource.data.lang);
      allow create: if mine(request.resource.data.personId) && request.resource.data.status == 'waiting'
        && request.resource.data.keys().hasOnly(['lang', 'en', 'text', 'note', 'personId', 'name', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.lang is string && request.resource.data.en is string
        && request.resource.data.text is string && request.resource.data.text.size() <= 3000
        && request.resource.data.get('note', '') is string && request.resource.data.get('note', '').size() <= 500;
      allow update: if (may('words') || checks(resource.data.lang))
        && onlyChanges(['status', 'reply', 'reviewedBy', 'reviewedAt', 'updatedAt'])
        && request.resource.data.status in ['used', 'declined'];
      allow delete: if may('words') || checks(resource.data.lang) || mine(resource.data.personId);
    }

    // ---------- leadership groups (js/leaders.js): the Council, elders, ministry leaders ----------
    // Names, roles, titles and portfolios only. Administrators and Pastors set them up. An open group is seen by everyone
    // signed in; any other only by its own members.
    function bodyRef(id) { return /databases/$(database)/documents/leaderBodies/$(id); }
    function inBody(id) { return anyone() && meIn(get(bodyRef(id)).data.get('memberIds', [])); }
    match /leaderBodies/{id} {
      allow read: if manager() || (anyone() && (resource.data.get('open', false) == true || meIn(resource.data.get('memberIds', []))));
      allow create, update: if manager() && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.open is bool && request.resource.data.memberIds is list;
      allow delete: if manager();
    }

    // ---------- the Archive (js/archive.js): minutes, plans, staff contracts, appraisals ----------
    // Archive access is limited to Administrators and Council members. The record's own access rule remains an
    // additional limit for Council members; Administrators see and manage every record. Files follow the same rule.
    function seniorId() { return get(/databases/$(database)/documents/settings/church).data.get('seniorPastorId', ''); }
    function keeper() { return admin() || (isRole(['pastor']) && isMe(seniorId())); }
    function archivePreviewMember(id) {
      return id != '' && exists(/databases/$(database)/documents/archivePreviewMembers/$(id));
    }
    function councilMember() {
      return anyone() && (archivePreviewMember(me())
        || (also().size() > 0 && archivePreviewMember(also()[0]))
        || (also().size() > 1 && archivePreviewMember(also()[1]))
        || (also().size() > 2 && archivePreviewMember(also()[2])));
    }
    function archiveReader() { return admin() || councilMember(); }
    function seesRecord(d) {
      return archiveReader() && (admin()
        || (d.get('access', '') == 'all' && anyone())
        || (d.get('access', '') == 'office' && manager())
        || (d.get('bodyId', '') != '' && inBody(d.bodyId))
        || mine(d.get('shownTo', '')));
    }
    function okRecord(d) {
      return d.title is string && d.title.size() > 0 && d.title.size() <= 150
        && d.access in ['all', 'body', 'office', 'private']
        && d.get('bodyId', '') is string && (d.access == 'body') == (d.get('bodyId', '') != '')
        && d.get('shownTo', '') is string && (d.get('shownTo', '') == '' || d.shownTo == d.get('aboutId', ''))
        && d.get('displayOnApplication', false) is bool;
    }
    match /archive/{id} {
      allow read: if seesRecord(resource.data);
      allow create: if archiveReader() && okRecord(request.resource.data) && (admin() || !request.resource.data.get('displayOnApplication', false));
      allow update: if archiveReader() && okRecord(request.resource.data)
        && (admin() || request.resource.data.get('displayOnApplication', false) == resource.data.get('displayOnApplication', false));
      allow delete: if archiveReader();
      match /parts/{n} {
        allow read: if seesRecord(get(/databases/$(database)/documents/archive/$(id)).data);
        allow create, update: if archiveReader() && request.resource.data.keys().hasOnly(['data'])
          && request.resource.data.data is string && request.resource.data.data.size() <= 950000;
        allow delete: if archiveReader();
      }
    }
    // A deliberately limited public copy of documents an Administrator selected for the membership form.
    // Private archive notes, access rules, staff details and source files are never copied here.
    match /applicationDocuments/{id} {
      allow read: if anyone();
      allow create, update: if admin() && request.resource.data.keys().hasOnly(['title', 'date', 'link', 'fileName', 'fileType', 'parts', 'fileVersion'])
        && request.resource.data.keys().hasAll(['title', 'date', 'link', 'fileName', 'fileType', 'parts', 'fileVersion'])
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 150
        && request.resource.data.date is string && request.resource.data.date.size() <= 10
        && request.resource.data.link is string && request.resource.data.link.size() <= 500
        && request.resource.data.fileName is string && request.resource.data.fileName.size() <= 150
        && request.resource.data.fileType is string && request.resource.data.fileType.size() <= 150
        && request.resource.data.parts is int && request.resource.data.parts >= 0 && request.resource.data.parts <= 24
        && request.resource.data.fileVersion is string && request.resource.data.fileVersion.size() <= 80
        && ((request.resource.data.parts == 0 && request.resource.data.fileVersion == '') || (request.resource.data.parts > 0 && request.resource.data.fileVersion.size() > 0));
      allow delete: if admin();
      match /files/{version}/parts/{n} {
        allow read: if anyone() && exists(/databases/$(database)/documents/applicationDocuments/$(id))
          && get(/databases/$(database)/documents/applicationDocuments/$(id)).data.fileVersion == version;
        allow create, update: if admin() && request.resource.data.keys().hasOnly(['data'])
          && request.resource.data.data is string && request.resource.data.data.size() <= 950000;
        allow delete: if admin();
      }
    }
    // Kept in step with Council membership in the Leadership page; only Administrators and Pastors maintain this list.
    match /archivePreviewMembers/{id} {
      allow read: if manager() || isMe(id);
      allow create, update: if manager() && request.resource.data.keys().hasOnly(['personId']) && request.resource.data.personId == id;
      allow delete: if manager();
    }
    function okArchivePreviewPart(d) {
      return d.keys().hasOnly(['data']) && d.data is string && d.data.size() <= 950000;
    }
    match /archivePreviews/{id}/parts/{n} {
      allow read: if admin() || (councilMember() && seesRecord(get(/databases/$(database)/documents/archive/$(id)).data));
      allow create, update: if okArchivePreviewPart(request.resource.data)
        && (admin() || councilMember());
      allow delete: if admin() || councilMember();
    }

    // ---------- the Library (js/library.js) ----------
    // Everyone signed in sees the items (books, DVDs, CDs...), their covers and the library's policy. The librarians
    // (Administrators, and the people named in settings librarianIds by an Administrator or the Senior Pastor) add items,
    // write the policy and record loans and returns. A loan is seen by the librarians and by the person who borrowed it.
    // A new loan needs the borrower's name and mobile number (a visitor not on the church's list has no personId).
    function librarian() {
      return admin() || (anyone() && meIn(get(/databases/$(database)/documents/settings/church).data.get('librarianIds', [])));
    }
    match /books/{id} {
      allow read: if anyone();
      allow create: if librarian() && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 150;
      allow update: if (librarian() && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 150)
        || (anyone() && onlyChanges(['out', 'lastClaimId']) && validLibraryClaim(id));
      allow delete: if librarian();
    }
    function okLoan(d) {
      return d.bookId is string && d.personId is string && d.get('mobile', '') is string && d.get('mobile', '').size() <= 30
        && (d.personId != '' || (d.get('visitor', false) == true && d.get('name', '') is string && d.get('name', '').size() > 0 && d.get('name', '').size() <= 100));
    }
    function pendingLibraryLoan(d) {
      return d.status == 'pending' && d.get('back', '') == '' && d.get('visitor', false) == false
        && d.personId is string && isMe(d.personId) && d.get('name', '') is string && d.get('name', '').size() > 0
        && d.get('name', '').size() <= 100 && d.get('mobile', '') is string && d.get('mobile', '').size() >= 7
        && d.get('mobile', '').size() <= 30
        && d.keys().hasOnly(['bookId', 'title', 'personId', 'name', 'mobile', 'visitor', 'out', 'due', 'back', 'note', 'status', 'requestedAt', 'createdAt', 'updatedAt']);
    }
    function validLibraryClaim(id) {
      let bookPath = /databases/$(database)/documents/books/$(id);
      let loanId = request.resource.data.get('lastClaimId', '');
      let loanPath = /databases/$(database)/documents/loans/$(loanId);
      return loanId is string && loanId.size() > 0 && existsAfter(loanPath)
        && getAfter(loanPath).data.bookId == id && getAfter(loanPath).data.status == 'pending'
        && isMe(getAfter(loanPath).data.personId) && getAfter(loanPath).data.get('back', '') == ''
        && getAfter(bookPath).data.out == resource.data.get('out', 0) + 1
        && getAfter(bookPath).data.out <= resource.data.get('copies', 1)
        && resource.data.get('removed', '') == '' && resource.data.get('repairing', false) == false;
    }
    function validClaimedBook(id) {
      let bookPath = /databases/$(database)/documents/books/$(request.resource.data.bookId);
      return existsAfter(bookPath) && getAfter(bookPath).data.lastClaimId == id
        && getAfter(bookPath).data.out == get(bookPath).data.get('out', 0) + 1
        && getAfter(bookPath).data.out <= get(bookPath).data.get('copies', 1)
        && get(bookPath).data.get('removed', '') == '' && get(bookPath).data.get('repairing', false) == false;
    }
    match /loans/{id} {
      allow read: if librarian() || mine(resource.data.get('personId', ''));
      allow create: if (librarian() && okLoan(request.resource.data) && request.resource.data.get('mobile', '').size() >= 7)
        || (anyone() && pendingLibraryLoan(request.resource.data) && validClaimedBook(id));
      allow update: if librarian() && okLoan(request.resource.data);
      allow delete: if librarian();
    }
    match /libraryDuplicateIgnores/{id} {
      allow read: if librarian();
      allow create, update: if librarian() && request.resource.data.keys().hasOnly(['pair', 'createdAt', 'updatedAt'])
        && request.resource.data.pair == id && id.size() <= 200;
      allow delete: if librarian();
    }
    match /covers/{id} {
      allow read: if anyone();
      allow create, update: if librarian() && request.resource.data.keys().hasOnly(['data', 'updatedAt'])
        && request.resource.data.data is string && request.resource.data.data.size() < 200000;
      allow delete: if librarian();
    }
    match /libraryPolicy/{doc} {
      allow read: if anyone();
      allow create, update: if doc == 'policy' && (librarian() || keeper())
        && request.resource.data.keys().hasOnly(['text', 'name', 'type', 'data', 'updatedAt', 'by'])
        && request.resource.data.get('text', '') is string && request.resource.data.get('text', '').size() <= 20000
        && request.resource.data.get('data', '') is string && request.resource.data.get('data', '').size() <= 900000;
      allow delete: if librarian() || keeper();
    }

    // ---------- POPIA registers (Administrators, and Pastors with "privacy") ----------
    match /dsr/{id} { allow read, write: if may('privacy'); }
    match /breaches/{id} { allow read, write: if may('privacy'); }
    // The day's email prompts already sent or set aside (Home): Administrators only, cleared each day
    match /emailPrompts/{id} { allow read, write: if may('settings'); }
    // Audit log: everyone signed in can add an entry about themselves; only Administrators read it; nobody changes it.
    match /audit/{id} {
      allow read: if may('privacy');
      allow create: if anyone()
        && request.resource.data.byEmail == request.auth.token.email.lower()
        && request.resource.data.ts == request.time;
      allow update, delete: if false;
    }
  }
}
